	<chart id="58" name="" title="Power" >
		<property name="title" type="QString" value="Power" />
		<property name="subtitle" type="QString" value="" />
		<property name="widthFactor" type="double" value="6.25" />
		<property name="heightFactor" type="double" value="1.72414" />
		<property name="style" type="int" value="2" />
		<property name="resizable" type="bool" value="1" />
		<property name="html" type="QString" value="&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n&lt;meta charset=&quot;utf-8&quot;&gt;\n&lt;title&gt;Power&lt;/title&gt;\n&lt;script src=&quot;qrc:///qtwebchannel/qwebchannel.js&quot;&gt;&lt;/script&gt;\n&lt;style&gt;\n  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #000; color: #fff;\n    font-family: -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; user-select: none; }\n  #wrap { position: absolute; inset: 0; box-sizing: border-box; padding: 2vh 8vw 3vh;\n    display: flex; flex-direction: column; align-items: center; }\n  .label { font-size: max(11px, min(9vw, 4vh)); letter-spacing: 0.08em; color: rgba(255,255,255,0.6); font-weight: 600; }\n  #val { font-size: max(20px, min(30vw, 13vh)); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; margin-top: 1vh; }\n  .unit { font-size: max(11px, min(9vw, 4vh)); color: rgba(255,255,255,0.6); }\n  #pct { font-size: max(11px, min(10vw, 4.5vh)); color: #e9d5ff; white-space: nowrap; margin-top: 0.5vh; font-variant-numeric: tabular-nums; }\n  #delta { font-size: max(12px, min(12vw, 5.5vh)); font-weight: 700; margin: 1vh 0 2vh; font-variant-numeric: tabular-nums; }\n  #track { position: relative; flex: 1; width: 42%; min-height: 40px; border: 1px solid rgba(255,255,255,0.25);\n    border-radius: 8px; overflow: visible; }\n  #fill { position: absolute; left: 0; right: 0; bottom: 0; height: 0%; border-radius: 7px;\n    transition: height 0.4s ease, box-shadow 0.4s ease; }\n  #marker { position: absolute; left: -12%; right: -12%; height: 4px; margin-bottom: -2px; bottom: 0;\n    background: #fff; border-radius: 2px; box-shadow: 0 0 6px rgba(0,0,0,0.9); transition: bottom 0.25s linear; z-index: 3; }\n  #ticks { position: absolute; top: 0; bottom: 0; right: 100%; margin-right: 6px; font-size: max(9px, min(6vw, 2.6vh));\n    color: rgba(255,255,255,0.5); }\n  #ticks span { position: absolute; right: 0; transform: translateY(50%); white-space: nowrap; }\n  #tline { position: absolute; left: -12%; right: -12%; height: 4px; margin-bottom: -2px; bottom: 0; display: none; z-index: 2;\n    background: #e9d5ff; border-radius: 2px; box-shadow: 0 0 6px rgba(0,0,0,0.9), 0 0 10px rgba(168,85,247,0.9);\n    transition: bottom 0.4s ease; }\n  #tlab { position: absolute; left: 100%; margin-left: 6px; top: 50%; transform: translateY(-50%); white-space: nowrap;\n    font-size: max(9px, min(6vw, 2.6vh)); font-weight: 700; color: #e9d5ff; font-variant-numeric: tabular-nums; }\n  #brk { position: absolute; left: 0; right: 0; bottom: 80%; border-top: 1px dashed rgba(255,255,255,0.3); pointer-events: none; }\n  #status { position: fixed; top: 2px; right: 6px; font-size: 10px; color: rgba(255,255,255,0.4); }\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n&lt;div id=&quot;wrap&quot;&gt;\n  &lt;div class=&quot;label&quot;&gt;3 SEC POWER&lt;/div&gt;\n  &lt;div id=&quot;val&quot;&gt;0&lt;/div&gt;\n  &lt;div class=&quot;unit&quot;&gt;W&lt;/div&gt;\n  &lt;div id=&quot;pct&quot;&gt;&lt;/div&gt;\n  &lt;div id=&quot;delta&quot;&gt;&lt;/div&gt;\n  &lt;div id=&quot;track&quot;&gt;&lt;div id=&quot;fill&quot;&gt;&lt;/div&gt;&lt;div id=&quot;brk&quot;&gt;&lt;/div&gt;&lt;div id=&quot;tline&quot;&gt;&lt;span id=&quot;tlab&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div id=&quot;ticks&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;div id=&quot;status&quot;&gt;&lt;/div&gt;\n&lt;script&gt;\n  // ---------- Shared helpers ----------\n  var cfg = { ftp: 0, zoneLows: null, zoneColors: null, hrLows: null, hrColors: null };\n  var DEF_PCT = [0, 0.55, 0.75, 0.90, 1.05, 1.20, 1.50];\n  var DEF_COL = [&quot;#9ca3af&quot;, &quot;#3b82f6&quot;, &quot;#22c55e&quot;, &quot;#eab308&quot;, &quot;#f97316&quot;, &quot;#ef4444&quot;, &quot;#a855f7&quot;];\n\n  function ftp() { return Number(cfg.ftp) || 200; }\n\n  function powerColor(w) {\n    var lows = cfg.zoneLows, cols = cfg.zoneColors;\n    if (!lows || !cols) {\n      lows = DEF_PCT.map(function (p) { return p * ftp(); });\n      cols = DEF_COL;\n    }\n    var c = cols[0];\n    for (var i = 0; i &lt; lows.length; i++) if (w &gt;= lows[i]) c = cols[i] || c;\n    return bright(c);\n  }\n\n  // Lift dark zone colors so they read well on black\n  function bright(hex) {\n    if (!hex || hex.charAt(0) !== &quot;#&quot; || hex.length &lt; 7) return hex;\n    var r = parseInt(hex.substr(1, 2), 16), g = parseInt(hex.substr(3, 2), 16), b = parseInt(hex.substr(5, 2), 16);\n    var lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;\n    if (lum &gt;= 120) return hex;\n    var k = Math.min(0.75, (120 - lum) / 160 + 0.25);\n    r = Math.round(r + (255 - r) * k); g = Math.round(g + (255 - g) * k); b = Math.round(b + (255 - b) * k);\n    return &quot;rgb(&quot; + r + &quot;,&quot; + g + &quot;,&quot; + b + &quot;)&quot;;\n  }\n\n  // On-target status colors (bright, readable on black)\n  var ON = &quot;#22c55e&quot;, OVER = &quot;#fb923c&quot;, UNDER = &quot;#60a5fa&quot;;\n  function targetColor(actual, target) {\n    if (!(target &gt; 0)) return &quot;#ffffff&quot;;\n    var tol = Math.max(5, target * 0.05), diff = actual - target;\n    return Math.abs(diff) &lt;= tol ? ON : (diff &gt; 0 ? OVER : UNDER);\n  }\n\n\n  // Bar colors by percent of FTP (matches the Workout chart's colors)\n  var BAR_LEVELS = [\n    [0.00, &quot;#ff00ff&quot;],  // below 54%: magenta\n    [0.54, &quot;#2a00ff&quot;],  // 54 to 74%: blue\n    [0.74, &quot;#00aaff&quot;],  // 74 to 90%: sky blue\n    [0.90, &quot;#00ff80&quot;],  // 90 to 104%: spring green\n    [1.04, &quot;#55ff00&quot;],  // 104 to 120%: green\n    [1.20, &quot;#ffd500&quot;],  // 120 to 150%: yellow\n    [1.50, &quot;#ff0000&quot;]   // 150% and up: red\n  ];\n  function barColor(w) {\n    var pct = w / ftp(), col = BAR_LEVELS[0][1];\n    for (var i = 0; i &lt; BAR_LEVELS.length; i++) if (pct &gt;= BAR_LEVELS[i][0]) col = BAR_LEVELS[i][1];\n    return col;\n  }\n  function paintBar(el, w) {\n    var col = barColor(w);\n    el.style.background = &quot;linear-gradient(to top, &quot; + col + &quot; 0%, &quot; + col + &quot; 70%, rgba(255,255,255,0.55) 140%)&quot;;\n    el.style.boxShadow = &quot;0 0 14px &quot; + col;\n  }\n\n  function hrColor(b) {\n    if (!cfg.hrLows || !cfg.hrColors || !b) return &quot;#ffffff&quot;;\n    var c = &quot;#ffffff&quot;;\n    for (var i = 0; i &lt; cfg.hrLows.length; i++) if (b &gt;= cfg.hrLows[i]) c = cfg.hrColors[i] || c;\n    return bright(c);\n  }\n\n  function barMax() {\n    var m = ftp() * 1.6;\n    if (cfg.zoneLows &amp;&amp; cfg.zoneLows.length) m = Math.max(m, Math.max.apply(null, cfg.zoneLows) * 1.3);\n    return Math.max(250, Math.round(m / 50) * 50);\n  }\n\n  function fmt(ms, withHours) {\n    if (ms === undefined || ms === null || isNaN(ms) || ms &lt; 0) ms = 0;\n    var t = Math.floor(ms / 1000);\n    var h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;\n    var mm = String(m).padStart(2, &quot;0&quot;), ss = String(s).padStart(2, &quot;0&quot;);\n    return (withHours || h &gt; 0) ? (h + &quot;:&quot; + mm + &quot;:&quot; + ss) : (mm + &quot;:&quot; + ss);\n  }\n\n  // Rolling time-based average (ms window)\n  function Roller(windowMs) {\n    var buf = [];\n    this.add = function (v) {\n      var now = Date.now();\n      buf.push([now, v]);\n      while (buf.length &amp;&amp; now - buf[0][0] &gt; windowMs) buf.shift();\n    };\n    this.avg = function () {\n      if (!buf.length) return 0;\n      var s = 0;\n      for (var i = 0; i &lt; buf.length; i++) s += buf[i][1];\n      return s / buf.length;\n    };\n  }\n\n  function applyConfig(c) {\n    try {\n      if (!c) return;\n      if (typeof c === &quot;string&quot;) c = JSON.parse(c);\n      if (c.power) {\n        if (c.power.ftp) cfg.ftp = c.power.ftp;\n        if (c.power.cp &amp;&amp; !cfg.ftp) cfg.ftp = c.power.cp;\n        if (c.power.zoneLows &amp;&amp; c.power.zoneColors) {\n          cfg.zoneLows = c.power.zoneLows;\n          cfg.zoneColors = c.power.zoneColors;\n        }\n      }\n      if (c.hr &amp;&amp; c.hr.zoneLows &amp;&amp; c.hr.zoneColors) {\n        cfg.hrLows = c.hr.zoneLows;\n        cfg.hrColors = c.hr.zoneColors;\n      }\n    } catch (e) { }\n    if (typeof onConfig === &quot;function&quot;) onConfig();\n  }\n\n  var workoutMs = 0;\n  function applyRoute(r) {\n    try {\n      if (!r) return;\n      if (typeof r === &quot;string&quot;) r = JSON.parse(r);\n      if (r &amp;&amp; r.workout &amp;&amp; r.workout.duration_msecs) workoutMs = Number(r.workout.duration_msecs) || 0;\n    } catch (e) { }\n  }\n\n  function connectGC(onData, simulate) {\n    if (typeof QWebChannel !== &quot;undefined&quot; &amp;&amp; window.qt &amp;&amp; qt.webChannelTransport) {\n      new QWebChannel(qt.webChannelTransport, function (channel) {\n        var gc = channel.objects.gc;\n        if (gc &amp;&amp; gc.getConfig) {\n          var r = gc.getConfig(applyConfig);\n          if (r &amp;&amp; typeof r.then === &quot;function&quot;) r.then(applyConfig);\n        }\n        if (gc &amp;&amp; gc.getPlannedRoute) {\n          var q = gc.getPlannedRoute(applyRoute);\n          if (q &amp;&amp; typeof q.then === &quot;function&quot;) q.then(applyRoute);\n        }\n        if (gc &amp;&amp; gc.plannedRouteChanged) gc.plannedRouteChanged.connect(applyRoute);\n        if (gc &amp;&amp; gc.telemetry) {\n          gc.telemetry.connect(function (p) {\n            var d = typeof p === &quot;string&quot; ? JSON.parse(p) : p;\n            onData(d || {});\n          });\n        }\n      });\n    } else {\n      var st = document.getElementById(&quot;status&quot;);\n      if (st) st.innerText = &quot;Preview (simulated data)&quot;;\n      var t0 = Date.now(), lapStart = t0, lap = 0;\n      workoutMs = 20 * 60000;\n      setInterval(function () {\n        var el = Date.now() - t0;\n        var lapLen = 20000;\n        if (Date.now() - lapStart &gt; lapLen) { lapStart = Date.now(); lap++; }\n        var target = [130, 180, 240, 300][lap % 4];\n        onData({\n          &quot;Power&quot;: target + (Math.random() * 40 - 20),\n          &quot;Target Power&quot;: target,\n          &quot;Time&quot;: el,\n          &quot;Lap Time Remaining&quot;: lapLen - (Date.now() - lapStart),\n          &quot;Heart Rate&quot;: 120 + 25 * Math.sin(el / 40000)\n        });\n      }, 500);\n    }\n  }\n\n  var roll = new Roller(3000);\n\n  // Stretched scale: 0 to 400 W fills the bottom 80% of the bar, 400 to 600 W the top 20%\n  var SCALE_BREAK = 400, SCALE_TOP = 600, BREAK_PCT = 80;\n  function barPct(w) {\n    w = Math.max(0, Number(w) || 0);\n    if (w &lt;= SCALE_BREAK) return w / SCALE_BREAK * BREAK_PCT;\n    return Math.min(100, BREAK_PCT + (w - SCALE_BREAK) / (SCALE_TOP - SCALE_BREAK) * (100 - BREAK_PCT));\n  }\n\n  function buildTicks() {\n    var el = document.getElementById(&quot;ticks&quot;);\n    el.innerHTML = &quot;&quot;;\n    for (var w = 0; w &lt;= SCALE_TOP; w += 100) {\n      var s = document.createElement(&quot;span&quot;);\n      s.style.bottom = barPct(w) + &quot;%&quot;;\n      s.innerText = w;\n      el.appendChild(s);\n    }\n  }\n  function onConfig() { buildTicks(); }\n\n  function onData(d) {\n    roll.add(Number(d[&quot;Power&quot;]) || 0);\n    var p = roll.avg();\n    var t = Number(d[&quot;Target Power&quot;]) || 0;\n    var v = document.getElementById(&quot;val&quot;), pct = document.getElementById(&quot;pct&quot;), dl = document.getElementById(&quot;delta&quot;);\n    var f = document.getElementById(&quot;fill&quot;), tl = document.getElementById(&quot;tline&quot;);\n\n    // Current 3 second power: big number and the colored fill\n    v.innerText = Math.round(p);\n    v.style.color = targetColor(p, t);\n    f.style.height = barPct(p) + &quot;%&quot;;\n    paintBar(f, p);\n\n    // Target: text under the number and a line on the bar\n    if (t &gt; 0) {\n      pct.innerText = &quot;TARGET &quot; + Math.round(t) + &quot; W (&quot; + Math.round(t / ftp() * 100) + &quot;%)&quot;;\n      var diff = Math.round(p - t);\n      dl.innerText = (diff &gt; 0 ? &quot;+&quot; : &quot;&quot;) + diff + &quot; W&quot;;\n      dl.style.color = targetColor(p, t);\n      tl.style.display = &quot;block&quot;;\n      tl.style.bottom = barPct(t) + &quot;%&quot;;\n      document.getElementById(&quot;tlab&quot;).innerText = Math.round(t);\n    } else {\n      pct.innerText = &quot;&quot;; dl.innerText = &quot;&quot;; tl.style.display = &quot;none&quot;;\n    }\n  }\n\n  window.onload = function () { buildTicks(); connectGC(onData); };\n&lt;/script&gt;\n&lt;/body&gt;\n&lt;/html&gt;" />
		<property name="splitterState" type="QByteArray" value="" />
		<property name="showEditor" type="bool" value="0" />
		<property name="chartConfig" type="QString" value="" />
		<property name="showTitleBar" type="bool" value="0" />
	</chart>
	<chart id="58" name="" title="Workout Stats" >
		<property name="title" type="QString" value="Workout Stats" />
		<property name="subtitle" type="QString" value="" />
		<property name="widthFactor" type="double" value="1" />
		<property name="heightFactor" type="double" value="6.25" />
		<property name="style" type="int" value="2" />
		<property name="resizable" type="bool" value="1" />
		<property name="html" type="QString" value="&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n&lt;meta charset=&quot;utf-8&quot;&gt;\n&lt;title&gt;Workout Stats&lt;/title&gt;\n&lt;script src=&quot;qrc:///qtwebchannel/qwebchannel.js&quot;&gt;&lt;/script&gt;\n&lt;style&gt;\n  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #000; color: #fff;\n    font-family: -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; user-select: none; }\n  #row { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(5, 1fr); }\n  .cell { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center;\n    border-left: 1px solid rgba(255,255,255,0.15); min-width: 0; padding: 0 1vw; }\n  .cell:first-child { border-left: none; }\n  .label { font-size: max(10px, min(11vh, 1.3vw)); letter-spacing: 0.08em; color: rgba(255,255,255,0.6); font-weight: 600; white-space: nowrap; }\n  .val { font-size: max(16px, min(50vh, 5.2vw)); font-weight: 700; line-height: 1.05; font-variant-numeric: tabular-nums; white-space: nowrap; }\n  .val small { font-size: 0.4em; font-weight: 500; color: rgba(255,255,255,0.6); margin-left: 0.2em; }\n  .sub { font-size: max(9px, min(10vh, 1.1vw)); color: rgba(255,255,255,0.6); font-variant-numeric: tabular-nums; white-space: nowrap; min-height: 1.2em; }\n  #prog { width: 80%; height: max(4px, 5vh); background: rgba(255,255,255,0.15); border-radius: 3px; overflow: hidden; margin-top: 1.5vh; }\n  #progFill { height: 100%; width: 0%; background: #e9d5ff; transition: width 0.5s linear; }\n  #hrBar { width: 40%; height: max(3px, 3vh); border-radius: 2px; margin-top: 1.5vh; background: transparent; }\n  .warn { color: #facc15; animation: pulse 1s ease-in-out infinite; }\n  .warn #progFill, #next.warn ~ #prog #progFill { background: #facc15; }\n  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }\n  #status { position: fixed; top: 2px; right: 6px; font-size: 10px; color: rgba(255,255,255,0.4); }\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n&lt;div id=&quot;row&quot;&gt;\n  &lt;div class=&quot;cell&quot;&gt;&lt;div class=&quot;label&quot;&gt;ELAPSED&lt;/div&gt;&lt;div class=&quot;val&quot; id=&quot;elapsed&quot;&gt;0:00:00&lt;/div&gt;&lt;div class=&quot;sub&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n  &lt;div class=&quot;cell&quot;&gt;&lt;div class=&quot;label&quot;&gt;TIME TO NEXT&lt;/div&gt;&lt;div class=&quot;val&quot; id=&quot;next&quot;&gt;--:--&lt;/div&gt;&lt;div id=&quot;prog&quot;&gt;&lt;div id=&quot;progFill&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n  &lt;div class=&quot;cell&quot;&gt;&lt;div class=&quot;label&quot;&gt;WORKOUT LEFT&lt;/div&gt;&lt;div class=&quot;val&quot; id=&quot;left&quot;&gt;--:--&lt;/div&gt;&lt;div class=&quot;sub&quot; id=&quot;leftPct&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n  &lt;div class=&quot;cell&quot;&gt;&lt;div class=&quot;label&quot;&gt;HEART RATE&lt;/div&gt;&lt;div class=&quot;val&quot;&gt;&lt;span id=&quot;hr&quot;&gt;--&lt;/span&gt;&lt;small&gt;bpm&lt;/small&gt;&lt;/div&gt;&lt;div id=&quot;hrBar&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n  &lt;div class=&quot;cell&quot;&gt;&lt;div class=&quot;label&quot;&gt;LAP AVG POWER&lt;/div&gt;&lt;div class=&quot;val&quot;&gt;&lt;span id=&quot;lap&quot;&gt;--&lt;/span&gt;&lt;small id=&quot;lapTgt&quot;&gt;W&lt;/small&gt;&lt;/div&gt;&lt;div class=&quot;sub&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;div id=&quot;status&quot;&gt;&lt;/div&gt;\n&lt;script&gt;\n  // ---------- Shared helpers ----------\n  var cfg = { ftp: 0, zoneLows: null, zoneColors: null, hrLows: null, hrColors: null };\n  var DEF_PCT = [0, 0.55, 0.75, 0.90, 1.05, 1.20, 1.50];\n  var DEF_COL = [&quot;#9ca3af&quot;, &quot;#3b82f6&quot;, &quot;#22c55e&quot;, &quot;#eab308&quot;, &quot;#f97316&quot;, &quot;#ef4444&quot;, &quot;#a855f7&quot;];\n\n  function ftp() { return Number(cfg.ftp) || 200; }\n\n  function powerColor(w) {\n    var lows = cfg.zoneLows, cols = cfg.zoneColors;\n    if (!lows || !cols) {\n      lows = DEF_PCT.map(function (p) { return p * ftp(); });\n      cols = DEF_COL;\n    }\n    var c = cols[0];\n    for (var i = 0; i &lt; lows.length; i++) if (w &gt;= lows[i]) c = cols[i] || c;\n    return bright(c);\n  }\n\n  // Lift dark zone colors so they read well on black\n  function bright(hex) {\n    if (!hex || hex.charAt(0) !== &quot;#&quot; || hex.length &lt; 7) return hex;\n    var r = parseInt(hex.substr(1, 2), 16), g = parseInt(hex.substr(3, 2), 16), b = parseInt(hex.substr(5, 2), 16);\n    var lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;\n    if (lum &gt;= 120) return hex;\n    var k = Math.min(0.75, (120 - lum) / 160 + 0.25);\n    r = Math.round(r + (255 - r) * k); g = Math.round(g + (255 - g) * k); b = Math.round(b + (255 - b) * k);\n    return &quot;rgb(&quot; + r + &quot;,&quot; + g + &quot;,&quot; + b + &quot;)&quot;;\n  }\n\n  // On-target status colors (bright, readable on black)\n  var ON = &quot;#22c55e&quot;, OVER = &quot;#fb923c&quot;, UNDER = &quot;#60a5fa&quot;;\n  function targetColor(actual, target) {\n    if (!(target &gt; 0)) return &quot;#ffffff&quot;;\n    var tol = Math.max(5, target * 0.05), diff = actual - target;\n    return Math.abs(diff) &lt;= tol ? ON : (diff &gt; 0 ? OVER : UNDER);\n  }\n\n\n  // Vivid bar palette by zone (uses your GoldenCheetah zone boundaries, these colors)\n  var VIVID = [&quot;#b0b7c3&quot;, &quot;#00a8ff&quot;, &quot;#00e05a&quot;, &quot;#ffe000&quot;, &quot;#ff8a00&quot;, &quot;#ff1f3d&quot;, &quot;#e040fb&quot;, &quot;#ff40ff&quot;];\n  function barColor(w) {\n    var lows = cfg.zoneLows;\n    if (!lows || !lows.length) lows = DEF_PCT.map(function (p) { return p * ftp(); });\n    var idx = 0;\n    for (var i = 0; i &lt; lows.length; i++) if (w &gt;= lows[i]) idx = i;\n    return VIVID[Math.min(idx, VIVID.length - 1)];\n  }\n  function paintBar(el, w) {\n    var col = barColor(w);\n    el.style.background = &quot;linear-gradient(to top, &quot; + col + &quot; 0%, &quot; + col + &quot; 70%, rgba(255,255,255,0.55) 140%)&quot;;\n    el.style.boxShadow = &quot;0 0 14px &quot; + col;\n  }\n\n  function hrColor(b) {\n    if (!cfg.hrLows || !cfg.hrColors || !b) return &quot;#ffffff&quot;;\n    var c = &quot;#ffffff&quot;;\n    for (var i = 0; i &lt; cfg.hrLows.length; i++) if (b &gt;= cfg.hrLows[i]) c = cfg.hrColors[i] || c;\n    return bright(c);\n  }\n\n  function barMax() {\n    var m = ftp() * 1.6;\n    if (cfg.zoneLows &amp;&amp; cfg.zoneLows.length) m = Math.max(m, Math.max.apply(null, cfg.zoneLows) * 1.3);\n    return Math.max(250, Math.round(m / 50) * 50);\n  }\n\n  function fmt(ms, withHours) {\n    if (ms === undefined || ms === null || isNaN(ms) || ms &lt; 0) ms = 0;\n    var t = Math.floor(ms / 1000);\n    var h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;\n    var mm = String(m).padStart(2, &quot;0&quot;), ss = String(s).padStart(2, &quot;0&quot;);\n    return (withHours || h &gt; 0) ? (h + &quot;:&quot; + mm + &quot;:&quot; + ss) : (mm + &quot;:&quot; + ss);\n  }\n\n  // Rolling time-based average (ms window)\n  function Roller(windowMs) {\n    var buf = [];\n    this.add = function (v) {\n      var now = Date.now();\n      buf.push([now, v]);\n      while (buf.length &amp;&amp; now - buf[0][0] &gt; windowMs) buf.shift();\n    };\n    this.avg = function () {\n      if (!buf.length) return 0;\n      var s = 0;\n      for (var i = 0; i &lt; buf.length; i++) s += buf[i][1];\n      return s / buf.length;\n    };\n  }\n\n  function applyConfig(c) {\n    try {\n      if (!c) return;\n      if (typeof c === &quot;string&quot;) c = JSON.parse(c);\n      if (c.power) {\n        if (c.power.ftp) cfg.ftp = c.power.ftp;\n        if (c.power.cp &amp;&amp; !cfg.ftp) cfg.ftp = c.power.cp;\n        if (c.power.zoneLows &amp;&amp; c.power.zoneColors) {\n          cfg.zoneLows = c.power.zoneLows;\n          cfg.zoneColors = c.power.zoneColors;\n        }\n      }\n      if (c.hr &amp;&amp; c.hr.zoneLows &amp;&amp; c.hr.zoneColors) {\n        cfg.hrLows = c.hr.zoneLows;\n        cfg.hrColors = c.hr.zoneColors;\n      }\n    } catch (e) { }\n    if (typeof onConfig === &quot;function&quot;) onConfig();\n  }\n\n  var workoutMs = 0;\n  function applyRoute(r) {\n    try {\n      if (!r) return;\n      if (typeof r === &quot;string&quot;) r = JSON.parse(r);\n      if (r &amp;&amp; r.workout &amp;&amp; r.workout.duration_msecs) workoutMs = Number(r.workout.duration_msecs) || 0;\n    } catch (e) { }\n  }\n\n  function connectGC(onData, simulate) {\n    if (typeof QWebChannel !== &quot;undefined&quot; &amp;&amp; window.qt &amp;&amp; qt.webChannelTransport) {\n      new QWebChannel(qt.webChannelTransport, function (channel) {\n        var gc = channel.objects.gc;\n        if (gc &amp;&amp; gc.getConfig) {\n          var r = gc.getConfig(applyConfig);\n          if (r &amp;&amp; typeof r.then === &quot;function&quot;) r.then(applyConfig);\n        }\n        if (gc &amp;&amp; gc.getPlannedRoute) {\n          var q = gc.getPlannedRoute(applyRoute);\n          if (q &amp;&amp; typeof q.then === &quot;function&quot;) q.then(applyRoute);\n        }\n        if (gc &amp;&amp; gc.plannedRouteChanged) gc.plannedRouteChanged.connect(applyRoute);\n        if (gc &amp;&amp; gc.telemetry) {\n          gc.telemetry.connect(function (p) {\n            var d = typeof p === &quot;string&quot; ? JSON.parse(p) : p;\n            onData(d || {});\n          });\n        }\n      });\n    } else {\n      var st = document.getElementById(&quot;status&quot;);\n      if (st) st.innerText = &quot;Preview (simulated data)&quot;;\n      var t0 = Date.now(), lapStart = t0, lap = 0;\n      workoutMs = 20 * 60000;\n      setInterval(function () {\n        var el = Date.now() - t0;\n        var lapLen = 20000;\n        if (Date.now() - lapStart &gt; lapLen) { lapStart = Date.now(); lap++; }\n        var target = [130, 180, 240, 300][lap % 4];\n        onData({\n          &quot;Power&quot;: target + (Math.random() * 40 - 20),\n          &quot;Target Power&quot;: target,\n          &quot;Time&quot;: el,\n          &quot;Lap Time Remaining&quot;: lapLen - (Date.now() - lapStart),\n          &quot;Heart Rate&quot;: 120 + 25 * Math.sin(el / 40000)\n        });\n      }, 500);\n    }\n  }\n\n  // Lap averages are computed here and reset whenever a new lap starts\n  var lapSum = 0, lapTSum = 0, lapN = 0, lastLap = null, lastRem = null, lapDur = 0;\n\n  function firstKey(d, keys) {\n    for (var i = 0; i &lt; keys.length; i++) if (d[keys[i]] !== undefined) return d[keys[i]];\n    return undefined;\n  }\n\n  // Heart rate color: green up to 100 bpm, shading through yellow and orange to red at 160 bpm\n  var HR_LOW = 100, HR_HIGH = 160;\n  function hrGradient(b) {\n    var f = Math.min(1, Math.max(0, (b - HR_LOW) / (HR_HIGH - HR_LOW)));\n    var hue = Math.round(130 * (1 - f));\n    return &quot;hsl(&quot; + hue + &quot;, 95%, 55%)&quot;;\n  }\n\n  function onData(d) {\n    var time = d[&quot;Time&quot;];\n    if (time !== undefined) document.getElementById(&quot;elapsed&quot;).innerText = fmt(time, true);\n\n    // Time to next lap, with progress bar and a warning pulse in the last 10 seconds\n    var rem = d[&quot;Lap Time Remaining&quot;];\n    if (rem === undefined) rem = d[&quot;Section Time Remaining&quot;];\n    var nx = document.getElementById(&quot;next&quot;);\n    nx.innerText = rem === undefined ? &quot;--:--&quot; : fmt(rem, false);\n\n    var newLap = false;\n    if (d[&quot;Lap&quot;] !== undefined) { if (lastLap !== null &amp;&amp; d[&quot;Lap&quot;] !== lastLap) newLap = true; lastLap = d[&quot;Lap&quot;]; }\n    if (rem !== undefined) {\n      if (lastRem !== null &amp;&amp; rem &gt; lastRem + 2000) newLap = true;\n      if (lastRem === null || newLap) lapDur = rem;\n      lastRem = rem;\n    }\n    if (newLap) {\n      lapSum = 0; lapTSum = 0; lapN = 0;\n    }\n    var warn = rem !== undefined &amp;&amp; rem &gt; 0 &amp;&amp; rem &lt;= 10000;\n    nx.className = &quot;val&quot; + (warn ? &quot; warn&quot; : &quot;&quot;);\n    var pf = document.getElementById(&quot;progFill&quot;);\n    pf.style.width = (lapDur &gt; 0 &amp;&amp; rem !== undefined ? Math.min(100, Math.max(0, (1 - rem / lapDur) * 100)) : 0) + &quot;%&quot;;\n    pf.style.background = warn ? &quot;#facc15&quot; : &quot;#e9d5ff&quot;;\n\n    // Whole workout countdown\n    var left = firstKey(d, [&quot;Workout Time Remaining&quot;, &quot;Ergo Time Remaining&quot;, &quot;Total Time Remaining&quot;]);\n    if (left === undefined &amp;&amp; workoutMs &gt; 0 &amp;&amp; time !== undefined) left = Math.max(0, workoutMs - time);\n    var lf = document.getElementById(&quot;left&quot;), lp = document.getElementById(&quot;leftPct&quot;);\n    if (left !== undefined) {\n      lf.innerText = fmt(left, true);\n      if (workoutMs &gt; 0) lp.innerText = Math.round(Math.min(100, (1 - left / workoutMs) * 100)) + &quot;% done&quot;;\n    } else { lf.innerText = &quot;--:--&quot;; lp.innerText = &quot;&quot;; }\n\n    // Heart rate: number and accent bar shade from green to red\n    var hr = Math.round(Number(d[&quot;Heart Rate&quot;]) || 0);\n    var hrEl = document.getElementById(&quot;hr&quot;);\n    hrEl.innerText = hr &gt; 0 ? hr : &quot;--&quot;;\n    hrEl.style.color = hr &gt; 0 ? hrGradient(hr) : &quot;#fff&quot;;\n    document.getElementById(&quot;hrBar&quot;).style.background = hr &gt; 0 ? hrGradient(hr) : &quot;transparent&quot;;\n\n    // Lap average power compared with the average target for this lap\n    var p = Number(d[&quot;Power&quot;]) || 0, t = Number(d[&quot;Target Power&quot;]) || 0;\n    if (p &gt; 0) { lapSum += p; lapTSum += t; lapN++; }\n    var avg = lapN ? lapSum / lapN : 0, tavg = lapN ? lapTSum / lapN : 0;\n    var lapEl = document.getElementById(&quot;lap&quot;), lapT = document.getElementById(&quot;lapTgt&quot;);\n    lapEl.innerText = avg &gt; 0 ? Math.round(avg) : &quot;--&quot;;\n    lapEl.style.color = avg &gt; 0 ? targetColor(avg, tavg) : &quot;#fff&quot;;\n    lapT.innerText = tavg &gt; 0 ? &quot; / &quot; + Math.round(tavg) + &quot; W&quot; : &quot;W&quot;;\n  }\n\n  window.onload = function () { connectGC(onData); };\n&lt;/script&gt;\n&lt;/body&gt;\n&lt;/html&gt;" />
		<property name="splitterState" type="QByteArray" value="" />
		<property name="showEditor" type="bool" value="0" />
		<property name="chartConfig" type="QString" value="" />
		<property name="showTitleBar" type="bool" value="0" />
	</chart>
	<chart id="25" name="" title="Workout" >
		<property name="title" type="QString" value="Workout" />
		<property name="subtitle" type="QString" value="" />
		<property name="widthFactor" type="double" value="1" />
		<property name="heightFactor" type="double" value="3.57143" />
		<property name="style" type="int" value="2" />
		<property name="resizable" type="bool" value="1" />
		<property name="showNotifications" type="int" value="1" />
		<property name="lineWidth" type="int" value="0" />
		<property name="showCurves" type="int" value="30" />
		<property name="showColorZones" type="int" value="0" />
		<property name="colorZonesTransparency" type="int" value="0" />
		<property name="showTooltip" type="int" value="0" />
	</chart>
