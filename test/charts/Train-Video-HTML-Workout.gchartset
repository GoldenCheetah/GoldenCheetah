<layout name="Video Workout - HTML" style="2" type="1" expression="" trainswitch="3">
	<chart id="58" name="" title="Heart Rate" >
		<property name="title" type="QString" value="Heart Rate" />
		<property name="subtitle" type="QString" value="" />
		<property name="widthFactor" type="double" value="6.25" />
		<property name="heightFactor" type="double" value="1.72414" />
		<property name="style" type="int" value="2" />
		<property name="resizable" type="bool" value="1" />
		<property name="html" type="QString" value="&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n&lt;meta charset=&quot;utf-8&quot;&gt;\n&lt;title&gt;Heart Rate&lt;/title&gt;\n&lt;script src=&quot;qrc:///qtwebchannel/qwebchannel.js&quot;&gt;&lt;/script&gt;\n&lt;style&gt;\n  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #000; color: #fff;\n    font-family: -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; user-select: none; }\n  #wrap { position: absolute; inset: 0; box-sizing: border-box; padding: 2vh 8vw 3vh;\n    display: flex; flex-direction: column; align-items: center; }\n  .label { font-size: max(11px, min(9vw, 4vh)); letter-spacing: 0.08em; color: rgba(255,255,255,0.6); font-weight: 600; }\n  #val { font-size: max(20px, min(30vw, 13vh)); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; margin-top: 1vh; }\n  .unit { font-size: max(11px, min(9vw, 4vh)); color: rgba(255,255,255,0.6); margin-bottom: 2vh; }\n  #track { position: relative; flex: 1; width: 42%; min-height: 40px; border: 1px solid rgba(255,255,255,0.25);\n    border-radius: 8px; overflow: visible; }\n  #fill { position: absolute; left: 0; right: 0; bottom: 0; height: 0%; border-radius: 7px;\n    transition: height 0.25s linear, box-shadow 0.4s ease; }\n  #marker { position: absolute; left: -12%; right: -12%; height: 4px; margin-bottom: -2px; bottom: 0; display: none;\n    background: #fff; border-radius: 2px; box-shadow: 0 0 6px rgba(0,0,0,0.9), 0 0 10px rgba(168,85,247,0.9);\n    transition: bottom 0.4s ease; }\n  #ticks { position: absolute; top: 0; bottom: 0; left: 100%; margin-left: 6px; font-size: max(9px, min(6vw, 2.6vh));\n    color: rgba(255,255,255,0.5); }\n  #ticks span { position: absolute; transform: translateY(50%); white-space: nowrap; }\n  #brk { position: absolute; left: 0; right: 0; bottom: 80%; border-top: 1px dashed rgba(255,255,255,0.3); pointer-events: none; }\n  #status { position: fixed; top: 2px; right: 6px; font-size: 10px; color: rgba(255,255,255,0.4); }\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n&lt;div id=&quot;wrap&quot;&gt;\n  &lt;div class=&quot;label&quot;&gt;HEART RATE&lt;/div&gt;\n  &lt;div id=&quot;val&quot;&gt;--&lt;/div&gt;\n  &lt;div class=&quot;unit&quot;&gt;bpm&lt;/div&gt;\n  &lt;div id=&quot;track&quot;&gt;&lt;div id=&quot;fill&quot;&gt;&lt;/div&gt;&lt;div id=&quot;ticks&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;div id=&quot;status&quot;&gt;&lt;/div&gt;\n&lt;script&gt;\n  // ---------- Shared helpers ----------\n  var cfg = { ftp: 0, zoneLows: null, zoneColors: null, hrLows: null, hrColors: null };\n  var DEF_PCT = [0, 0.55, 0.75, 0.90, 1.05, 1.20, 1.50];\n  var DEF_COL = [&quot;#9ca3af&quot;, &quot;#3b82f6&quot;, &quot;#22c55e&quot;, &quot;#eab308&quot;, &quot;#f97316&quot;, &quot;#ef4444&quot;, &quot;#a855f7&quot;];\n\n  function ftp() { return Number(cfg.ftp) || 200; }\n\n  function powerColor(w) {\n    var lows = cfg.zoneLows, cols = cfg.zoneColors;\n    if (!lows || !cols) {\n      lows = DEF_PCT.map(function (p) { return p * ftp(); });\n      cols = DEF_COL;\n    }\n    var c = cols[0];\n    for (var i = 0; i &lt; lows.length; i++) if (w &gt;= lows[i]) c = cols[i] || c;\n    return bright(c);\n  }\n\n  // Lift dark zone colors so they read well on black\n  function bright(hex) {\n    if (!hex || hex.charAt(0) !== &quot;#&quot; || hex.length &lt; 7) return hex;\n    var r = parseInt(hex.substr(1, 2), 16), g = parseInt(hex.substr(3, 2), 16), b = parseInt(hex.substr(5, 2), 16);\n    var lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;\n    if (lum &gt;= 120) return hex;\n    var k = Math.min(0.75, (120 - lum) / 160 + 0.25);\n    r = Math.round(r + (255 - r) * k); g = Math.round(g + (255 - g) * k); b = Math.round(b + (255 - b) * k);\n    return &quot;rgb(&quot; + r + &quot;,&quot; + g + &quot;,&quot; + b + &quot;)&quot;;\n  }\n\n  // On-target status colors (bright, readable on black)\n  var ON = &quot;#22c55e&quot;, OVER = &quot;#fb923c&quot;, UNDER = &quot;#60a5fa&quot;;\n  function targetColor(actual, target) {\n    if (!(target &gt; 0)) return &quot;#ffffff&quot;;\n    var tol = Math.max(5, target * 0.05), diff = actual - target;\n    return Math.abs(diff) &lt;= tol ? ON : (diff &gt; 0 ? OVER : UNDER);\n  }\n\n\n  // Bar colors by percent of FTP (matches the Workout chart's colors)\n  var BAR_LEVELS = [\n    [0.00, &quot;#ff00ff&quot;],  // below 54%: magenta\n    [0.54, &quot;#2a00ff&quot;],  // 54 to 74%: blue\n    [0.74, &quot;#00aaff&quot;],  // 74 to 90%: sky blue\n    [0.90, &quot;#00ff80&quot;],  // 90 to 104%: spring green\n    [1.04, &quot;#55ff00&quot;],  // 104 to 120%: green\n    [1.20, &quot;#ffd500&quot;],  // 120 to 150%: yellow\n    [1.50, &quot;#ff0000&quot;]   // 150% and up: red\n  ];\n  function barColor(w) {\n    var pct = w / ftp(), col = BAR_LEVELS[0][1];\n    for (var i = 0; i &lt; BAR_LEVELS.length; i++) if (pct &gt;= BAR_LEVELS[i][0]) col = BAR_LEVELS[i][1];\n    return col;\n  }\n  function paintBar(el, w) {\n    var col = barColor(w);\n    el.style.background = &quot;linear-gradient(to top, &quot; + col + &quot; 0%, &quot; + col + &quot; 70%, rgba(255,255,255,0.55) 140%)&quot;;\n    el.style.boxShadow = &quot;0 0 14px &quot; + col;\n  }\n\n  function hrColor(b) {\n    if (!cfg.hrLows || !cfg.hrColors || !b) return &quot;#ffffff&quot;;\n    var c = &quot;#ffffff&quot;;\n    for (var i = 0; i &lt; cfg.hrLows.length; i++) if (b &gt;= cfg.hrLows[i]) c = cfg.hrColors[i] || c;\n    return bright(c);\n  }\n\n  function barMax() {\n    var m = ftp() * 1.6;\n    if (cfg.zoneLows &amp;&amp; cfg.zoneLows.length) m = Math.max(m, Math.max.apply(null, cfg.zoneLows) * 1.3);\n    return Math.max(250, Math.round(m / 50) * 50);\n  }\n\n  function fmt(ms, withHours) {\n    if (ms === undefined || ms === null || isNaN(ms) || ms &lt; 0) ms = 0;\n    var t = Math.floor(ms / 1000);\n    var h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;\n    var mm = String(m).padStart(2, &quot;0&quot;), ss = String(s).padStart(2, &quot;0&quot;);\n    return (withHours || h &gt; 0) ? (h + &quot;:&quot; + mm + &quot;:&quot; + ss) : (mm + &quot;:&quot; + ss);\n  }\n\n  // Rolling time-based average (ms window)\n  function Roller(windowMs) {\n    var buf = [];\n    this.add = function (v) {\n      var now = Date.now();\n      buf.push([now, v]);\n      while (buf.length &amp;&amp; now - buf[0][0] &gt; windowMs) buf.shift();\n    };\n    this.avg = function () {\n      if (!buf.length) return 0;\n      var s = 0;\n      for (var i = 0; i &lt; buf.length; i++) s += buf[i][1];\n      return s / buf.length;\n    };\n  }\n\n  function applyConfig(c) {\n    try {\n      if (!c) return;\n      if (typeof c === &quot;string&quot;) c = JSON.parse(c);\n      if (c.power) {\n        if (c.power.ftp) cfg.ftp = c.power.ftp;\n        if (c.power.cp &amp;&amp; !cfg.ftp) cfg.ftp = c.power.cp;\n        if (c.power.zoneLows &amp;&amp; c.power.zoneColors) {\n          cfg.zoneLows = c.power.zoneLows;\n          cfg.zoneColors = c.power.zoneColors;\n        }\n      }\n      if (c.hr &amp;&amp; c.hr.zoneLows &amp;&amp; c.hr.zoneColors) {\n        cfg.hrLows = c.hr.zoneLows;\n        cfg.hrColors = c.hr.zoneColors;\n      }\n    } catch (e) { }\n    if (typeof onConfig === &quot;function&quot;) onConfig();\n  }\n\n  var workoutMs = 0;\n  function applyRoute(r) {\n    try {\n      if (!r) return;\n      if (typeof r === &quot;string&quot;) r = JSON.parse(r);\n      if (r &amp;&amp; r.workout &amp;&amp; r.workout.duration_msecs) workoutMs = Number(r.workout.duration_msecs) || 0;\n    } catch (e) { }\n  }\n\n  function connectGC(onData, simulate) {\n    if (typeof QWebChannel !== &quot;undefined&quot; &amp;&amp; window.qt &amp;&amp; qt.webChannelTransport) {\n      new QWebChannel(qt.webChannelTransport, function (channel) {\n        var gc = channel.objects.gc;\n        if (gc &amp;&amp; gc.getConfig) {\n          var r = gc.getConfig(applyConfig);\n          if (r &amp;&amp; typeof r.then === &quot;function&quot;) r.then(applyConfig);\n        }\n        if (gc &amp;&amp; gc.getPlannedRoute) {\n          var q = gc.getPlannedRoute(applyRoute);\n          if (q &amp;&amp; typeof q.then === &quot;function&quot;) q.then(applyRoute);\n        }\n        if (gc &amp;&amp; gc.plannedRouteChanged) gc.plannedRouteChanged.connect(applyRoute);\n        if (gc &amp;&amp; gc.telemetry) {\n          gc.telemetry.connect(function (p) {\n            var d = typeof p === &quot;string&quot; ? JSON.parse(p) : p;\n            onData(d || {});\n          });\n        }\n      });\n    } else {\n      var st = document.getElementById(&quot;status&quot;);\n      if (st) st.innerText = &quot;Preview (simulated data)&quot;;\n      var t0 = Date.now(), lapStart = t0, lap = 0;\n      workoutMs = 20 * 60000;\n      setInterval(function () {\n        var el = Date.now() - t0;\n        var lapLen = 20000;\n        if (Date.now() - lapStart &gt; lapLen) { lapStart = Date.now(); lap++; }\n        var target = [130, 180, 240, 300][lap % 4];\n        onData({\n          &quot;Power&quot;: target + (Math.random() * 40 - 20),\n          &quot;Target Power&quot;: target,\n          &quot;Time&quot;: el,\n          &quot;Lap Time Remaining&quot;: lapLen - (Date.now() - lapStart),\n          &quot;Heart Rate&quot;: 120 + 25 * Math.sin(el / 40000)\n        });\n      }, 500);\n    }\n  }\n\n  // Heart rate scale: 75 bpm at the bottom of the bar, 200 bpm at the top\n  var HR_MIN = 75, HR_MAX = 200;\n  function hrPct(b) {\n    return Math.min(100, Math.max(0, (b - HR_MIN) / (HR_MAX - HR_MIN) * 100));\n  }\n\n  // Green up to 100 bpm, shading through yellow and orange to red at 160 bpm\n  // (the same colors as the heart rate box in Workout Stats)\n  var HR_LOW = 100, HR_HIGH = 160;\n  function hrGradient(b) {\n    var f = Math.min(1, Math.max(0, (b - HR_LOW) / (HR_HIGH - HR_LOW)));\n    return &quot;hsl(&quot; + Math.round(130 * (1 - f)) + &quot;, 95%, 55%)&quot;;\n  }\n\n  function buildTicks() {\n    var el = document.getElementById(&quot;ticks&quot;);\n    el.innerHTML = &quot;&quot;;\n    for (var b = HR_MIN; b &lt;= HR_MAX; b += 25) {\n      var s = document.createElement(&quot;span&quot;);\n      s.style.bottom = hrPct(b) + &quot;%&quot;;\n      s.innerText = b;\n      el.appendChild(s);\n    }\n  }\n  function onConfig() { buildTicks(); }\n\n  function onData(d) {\n    var hr = Math.round(Number(d[&quot;Heart Rate&quot;]) || 0);\n    var v = document.getElementById(&quot;val&quot;), f = document.getElementById(&quot;fill&quot;);\n    if (hr &gt; 0) {\n      var col = hrGradient(hr);\n      v.innerText = hr;\n      v.style.color = col;\n      f.style.height = hrPct(hr) + &quot;%&quot;;\n      f.style.background = &quot;linear-gradient(to top, &quot; + col + &quot; 0%, &quot; + col + &quot; 70%, rgba(255,255,255,0.55) 140%)&quot;;\n      f.style.boxShadow = &quot;0 0 14px &quot; + col;\n    } else {\n      v.innerText = &quot;--&quot;;\n      v.style.color = &quot;#fff&quot;;\n      f.style.height = &quot;0%&quot;;\n    }\n  }\n\n  window.onload = function () { buildTicks(); connectGC(onData); };\n&lt;/script&gt;\n&lt;/body&gt;\n&lt;/html&gt;" />
		<property name="splitterState" type="QByteArray" value="" />
		<property name="showEditor" type="bool" value="0" />
		<property name="chartConfig" type="QString" value="" />
		<property name="showTitleBar" type="bool" value="0" />
	</chart>
