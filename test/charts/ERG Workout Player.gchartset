<layout name="ERG Workout Player" style="2" type="1" expression="" trainswitch="0">
	<chart id="58" name="" title="Header" >
		<property name="title" type="QString" value="Header" />
		<property name="subtitle" type="QString" value="" />
		<property name="widthFactor" type="double" value="1" />
		<property name="heightFactor" type="double" value="8" />
		<property name="style" type="int" value="2" />
		<property name="resizable" type="bool" value="1" />
		<property name="html" type="QString" value="&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n&lt;meta charset=&quot;utf-8&quot;&gt;\n&lt;title&gt;Header&lt;/title&gt;\n&lt;script src=&quot;qrc:///qtwebchannel/qwebchannel.js&quot;&gt;&lt;/script&gt;\n&lt;style&gt;\n  :root { --v: 60px; --zc: #ffffff; --zb: rgba(255,255,255,0.12); --zg: rgba(255,255,255,0.3); --rc: #00d64f; --rb: rgba(0,214,79,0.1); }\n  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #000; color: #fff;\n    font-family: -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; user-select: none; }\n  #bar { position: absolute; inset: calc(var(--v) * 0.08) calc(var(--v) * 0.12); box-sizing: border-box;\n    border-radius: calc(var(--v) * 0.3); border: 1px solid rgba(255,255,255,0.08);\n    background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01));\n    display: grid; grid-template-columns: calc(var(--v) * 1.6) calc(var(--v) * 4.2) calc(var(--v) * 5) minmax(0, 1fr) calc(var(--v) * 5) calc(var(--v) * 4.2) calc(var(--v) * 1.6);\n    align-items: center; column-gap: calc(var(--v) * 0.25); padding: 0 calc(var(--v) * 0.3); }\n  #tcell { min-width: 0; text-align: center; overflow: hidden; }\n  #intensity { font-size: calc(var(--v) * 0.32); font-weight: 700; letter-spacing: 0.12em; color: #fff; white-space: nowrap;\n    line-height: 1.2; margin-top: calc(var(--v) * 0.04); display: none; }\n  #title { display: inline-block; max-width: 100%; vertical-align: middle;\n    background: linear-gradient(90deg, #29c5ff, #0066ff, #00d64f, #ffd400, #ff6a00, #ff1f3d);\n    -webkit-background-clip: text; background-clip: text; color: transparent; font-size: calc(var(--v) * 1.05); font-weight: 700;\n    letter-spacing: 0.06em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.15; }\n  .t { display: flex; flex-direction: column; align-items: center; }\n  .lab { font-size: calc(var(--v) * 0.3); font-weight: 600; letter-spacing: 0.12em; color: rgba(255,255,255,0.6); line-height: 1.2; white-space: nowrap; }\n  .val { font-size: var(--v); font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.05; }\n  .prog { width: 80%; height: calc(var(--v) * 0.12); margin-top: calc(var(--v) * 0.1); border-radius: calc(var(--v) * 0.1);\n    background: rgba(255,255,255,0.12); overflow: hidden; }\n  .fill { height: 100%; width: 0%; border-radius: inherit; transition: width 0.5s linear, background 0.3s ease; }\n  #wfill, #lfill { background: #e9e9ee; box-shadow: 0 0 calc(var(--v) * 0.15) rgba(255,255,255,0.5); }\n  .warn .val { color: #ffd400; animation: pulse 1s ease-in-out infinite; }\n  .warn .fill { background: #ffd400 !important; box-shadow: 0 0 calc(var(--v) * 0.2) rgba(255,212,0,0.7) !important; }\n  .last .val { color: #ff1f3d; }\n  .last .fill { background: #ff1f3d !important; box-shadow: 0 0 calc(var(--v) * 0.2) rgba(255,31,61,0.7) !important; }\n  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }\n\n  /* Countdown sound on/off button to the right of the timer (the same space is kept on the left so everything stays centered).\n     Speaker = beeps on; speaker with a red slash = beeps off; yellow pulsing speaker = on, but sound is blocked until clicked */\n  /* #sw holds the button and the &quot;4·3·2·1&quot; label arched over it; the label takes the same color as the speaker */\n  #sw { position: relative; justify-self: center; width: calc(var(--v) * 1.0); height: calc(var(--v) * 1.0); margin-top: calc(var(--v) * 0.36); }\n  #sw .arc { position: absolute; left: -40%; top: -40%; width: 180%; height: 180%; pointer-events: none; overflow: visible;\n    color: #fff; transition: color 0.2s ease; }\n  #sw .arc text { font-family: -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; font-size: 25px; font-weight: 600; letter-spacing: 3px; }\n  #sw.off .arc { color: rgba(255,255,255,0.5); }\n  #sw.blocked .arc { color: #ffd400; animation: pulse 1.4s ease-in-out infinite; }\n  #sound { width: 100%; height: 100%; border-radius: 50%; box-sizing: border-box;\n    display: flex; align-items: center; justify-content: center; cursor: pointer; color: #fff;\n    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.35); box-shadow: 0 0 calc(var(--v) * 0.15) rgba(255,255,255,0.15);\n    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease; }\n  #sound:hover { background: rgba(255,255,255,0.16); }\n  #sound svg { width: 62%; height: 62%; display: block; }\n  #sound.off { color: rgba(255,255,255,0.5); border-color: rgba(255,255,255,0.2); box-shadow: none; }\n  #sound.blocked { color: #ffd400; border-color: rgba(255,212,0,0.7); box-shadow: 0 0 calc(var(--v) * 0.2) rgba(255,212,0,0.45);\n    animation: pulse 1.4s ease-in-out infinite; }\n  /* Last interval recap panel (left of the title) */\n  .panel { height: calc(var(--v) * 1.75); box-sizing: border-box; border-radius: calc(var(--v) * 0.22);\n    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;\n    opacity: 0; transform: scale(0.96); transition: opacity 0.7s ease, transform 0.7s ease; min-width: 0; overflow: hidden; }\n  .panel.show { opacity: 1; transform: scale(1); }\n  .panel.out { transition: opacity 0.5s ease-in, transform 0.5s ease-in; }\n  #next { border: 1px solid var(--zc); background: radial-gradient(120% 120% at 50% 0%, var(--zb), rgba(0,0,0,0) 70%);\n    box-shadow: 0 0 calc(var(--v) * 0.25) var(--zg); }\n  #nw { color: var(--zc); text-shadow: 0 0 calc(var(--v) * 0.15) var(--zg); }\n  #recap { border: 1px solid rgba(255,255,255,0.14); background: radial-gradient(120% 120% at 50% 0%, var(--rb), rgba(0,0,0,0) 70%); }\n  .big { display: flex; align-items: baseline; justify-content: center; gap: calc(var(--v) * 0.22); line-height: 1.05; white-space: nowrap; }\n  .bw { font-size: calc(var(--v) * 0.72); font-weight: 700; font-variant-numeric: tabular-nums; }\n  .bu { font-size: calc(var(--v) * 0.3); font-weight: 600; color: rgba(255,255,255,0.6); margin-left: calc(var(--v) * -0.15); }\n  .bt { font-size: calc(var(--v) * 0.5); font-weight: 700; font-variant-numeric: tabular-nums; color: #fff; }\n  .sub { font-size: calc(var(--v) * 0.27); font-weight: 600; letter-spacing: 0.08em; color: rgba(255,255,255,0.75); white-space: pre; margin-top: calc(var(--v) * 0.04); }\n  #rw { color: var(--rc); }\n  .hr { color: #ff2a2a; } .cad { color: #b45cff; }\n  #status { position: fixed; top: 2px; right: 6px; font-size: 10px; color: rgba(255,255,255,0.4); }\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n&lt;div id=&quot;bar&quot;&gt;\n  &lt;div&gt;&lt;/div&gt;\n  &lt;div class=&quot;t&quot; id=&quot;tw&quot;&gt;&lt;div class=&quot;lab&quot;&gt;WORKOUT LEFT&lt;/div&gt;&lt;div class=&quot;val&quot; id=&quot;wleft&quot;&gt;--:--&lt;/div&gt;\n    &lt;div class=&quot;prog&quot;&gt;&lt;div class=&quot;fill&quot; id=&quot;wfill&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n  &lt;div class=&quot;panel&quot; id=&quot;recap&quot;&gt;\n    &lt;div class=&quot;lab&quot; id=&quot;rlab&quot;&gt;LAST INTERVAL&lt;/div&gt;\n    &lt;div class=&quot;big&quot;&gt;&lt;span class=&quot;bw&quot; id=&quot;rw&quot;&gt;--&lt;/span&gt;&lt;span class=&quot;bu&quot;&gt;W&lt;/span&gt;&lt;span class=&quot;bt&quot; id=&quot;rpct&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n    &lt;div class=&quot;sub&quot; id=&quot;rsub&quot;&gt;&lt;/div&gt;\n  &lt;/div&gt;\n  &lt;div id=&quot;tcell&quot;&gt;&lt;span id=&quot;title&quot;&gt;ERG WORKOUT&lt;/span&gt;&lt;div id=&quot;intensity&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n  &lt;div class=&quot;panel&quot; id=&quot;next&quot;&gt;\n    &lt;div class=&quot;lab&quot;&gt;UP NEXT&lt;/div&gt;\n    &lt;div class=&quot;big&quot;&gt;&lt;span class=&quot;bw&quot; id=&quot;nw&quot;&gt;--&lt;/span&gt;&lt;span class=&quot;bu&quot;&gt;W&lt;/span&gt;&lt;span class=&quot;bt&quot; id=&quot;nt&quot;&gt;--:--&lt;/span&gt;&lt;/div&gt;\n    &lt;div class=&quot;sub&quot; id=&quot;nsub&quot;&gt;&lt;/div&gt;\n  &lt;/div&gt;\n  &lt;div class=&quot;t&quot; id=&quot;tl&quot;&gt;&lt;div class=&quot;lab&quot;&gt;NEXT INTERVAL IN&lt;/div&gt;&lt;div class=&quot;val&quot; id=&quot;lleft&quot;&gt;--:--&lt;/div&gt;\n    &lt;div class=&quot;prog&quot;&gt;&lt;div class=&quot;fill&quot; id=&quot;lfill&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n  &lt;div id=&quot;sw&quot;&gt;&lt;div id=&quot;sound&quot;&gt;&lt;/div&gt;\n    &lt;svg class=&quot;arc&quot; viewBox=&quot;-40 -40 180 180&quot;&gt;&lt;path id=&quot;cdarc&quot; d=&quot;M -9 50 A 59 59 0 0 1 109 50&quot; fill=&quot;none&quot;/&gt;\n      &lt;text fill=&quot;currentColor&quot;&gt;&lt;textPath href=&quot;#cdarc&quot; startOffset=&quot;50%&quot; text-anchor=&quot;middle&quot;&gt;4·3·2·1&lt;/textPath&gt;&lt;/text&gt;&lt;/svg&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;div id=&quot;status&quot;&gt;&lt;/div&gt;\n&lt;script&gt;\n  // ---------- Settings ----------\n  var DEFAULT_TITLE = &quot;ERG WORKOUT&quot;;   // shown when GoldenCheetah doesn&apos;t supply the workout name\n  var WARN_SECS = 10;                  // next-interval timer pulses yellow for the last 10 seconds...\n  var LAST_SECS = 3;                   // ...and turns red for the last 3\n  var TIMER_SIZE = 1.0;                // timer numbers compared to the gauge numbers (1 = same size)\n  var RECAP_DELAY_SECS = 1;            // &quot;Last interval&quot; recap fades in this long after an interval ends...\n  var RECAP_SHOW_SECS = 30;            // ...and stays up this long before fading out\n  var RECAP_MIN_SECS = 15;             // intervals shorter than this get no recap (15 second intervals are recapped)\n  var ON_TARGET_PCT = 5;               // recap is green within this many percent of target\n  var COUNTDOWN_SOUND = true;          // countdown beeps start on (true) or off (false) when the perspective loads; the speaker\n                                       //    button turns them on and off during the ride (4, 3, 2, 1, then a slightly longer beep)\n  var COUNTDOWN_FROM = 4;              // first beep this many seconds before the interval\n  var COUNTDOWN_VOLUME = 0.6;          // 0 (silent) to 1 (loudest)\n  var COUNTDOWN_ALL_LAPS = true;       // true = before every lap (efforts and recoveries); false = only before efforts\n  var NEXT_SHOW_SECS = 30;             // &quot;Up next&quot; fades in this many seconds before the next interval...\n  var NEXT_HIDE_SECS = 0.9;            // ...and starts its quick fade out this many seconds before it starts\n  var NEXT_LOOK_PAST_MS = 1000;        // reads the plan this far past the start of the next lap (keeps clear of the lap edge)\n  var RECOVERY_PCT = 65;               // power at or below this % of FTP counts as recovery (ends an Up Next interval;\n                                       //    with COUNTDOWN_ALL_LAPS false, no countdown into it)\n  var BIG_DROP_PCT = 30;               // Up Next: a drop this far below the interval&apos;s average also ends it if the drop lasts\n  var BIG_DROP_SECS = 30;              // ...this long (short dips stay part of the interval); so does a jump this far above\n                                       //    the average after at least this long of riding\n  var SURGE_MAX_SECS = 30;             // Up Next: a kick this short at the end of an interval still belongs to it...\n  var SURGE_MAX_PCT = 60;              // ...if it&apos;s no more than this far above the interval&apos;s average (a sprint after tempo is its own interval)\n  var REPEAT_MATCH_PCT = 25;           // Up Next: efforts (and rests) this close in length count as repeats...\n  var REPEAT_MATCH_SECS = 5;           // ...or this many seconds, whichever is more...\n  var REPEAT_MAX_SECS = 10;            // ...but never more than this many seconds apart (so a ladder like 1:30, 1:15, 1:00 isn&apos;t a repeat)\n  var ZONE_COLORS = [&quot;#29c5ff&quot;, &quot;#0066ff&quot;, &quot;#00d64f&quot;, &quot;#ffd400&quot;, &quot;#ff6a00&quot;, &quot;#ff1f3d&quot;];\n  var ZONE_TOPS = [55.5, 75.5, 90.5, 105.5, 120.5];   // % of FTP where each zone ends\n  var ZONE_NAMES = [&quot;RECOVERY&quot;, &quot;ENDURANCE&quot;, &quot;TEMPO&quot;, &quot;THRESHOLD&quot;, &quot;VO2 MAX&quot;, &quot;ANAEROBIC&quot;];\n  var COUNTDOWN_BEEP_SECS = 0.16;      // length of the 4, 3, 2, 1 beeps\n  var COUNTDOWN_LAST_SECS = 0.35;      // length of the final &quot;go&quot; beep\n  var SHOW_INTENSITY = true;           // message under the title when GoldenCheetah&apos;s workout intensity is lowered or raised\n  var INTENSITY_SHOW_HIGHER = true;    // false = only show it when the intensity is lowered\n\n  var durationMs = 0, lapLen = 0, lastLapRem = null, ftp = 0, lastRoute = null;\n  var segs = [];                       // the planned workout as steps and ramps: {s, e, w0, w1}\n  var remMs = null, remAt = 0, running = true, curPos = null;\n  var cur = null;                      // stats for the interval in progress\n  var nextAt = null;                   // workout position where the next lap starts (position + lap time left, from the same update)\n  var lastTarget = 0, nextKey = &quot;&quot;;\n  var lastPosSeen = null, lastWall = 0, recapTimer = null, recapDelay = null;\n\n  function size() {\n    var gauge = (window.innerWidth - 84) / 5.9 * 0.96;\n    var v = Math.min(gauge * 0.2 * TIMER_SIZE, window.innerHeight / 2.1);\n    document.documentElement.style.setProperty(&quot;--v&quot;, Math.max(14, v) + &quot;px&quot;);\n    fitTitle();\n  }\n  // Shrink the title only when it doesn&apos;t fit its space\n  function fitTitle() {\n    var t = document.getElementById(&quot;title&quot;), cell = document.getElementById(&quot;tcell&quot;);\n    t.style.fontSize = &quot;&quot;;\n    var full = parseFloat(getComputedStyle(t).fontSize), w = t.scrollWidth, room = cell.clientWidth;\n    if (w &gt; room &amp;&amp; w &gt; 0) t.style.fontSize = Math.max(full * 0.45, full * room / w * 0.98) + &quot;px&quot;;\n  }\n\n  function fmtLen(ms) {   // interval length, like 3:00 or 0:30\n    var t = Math.round(ms / 1000), h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;\n    return (h &gt; 0 ? h + &quot;:&quot; + String(m).padStart(2, &quot;0&quot;) : m) + &quot;:&quot; + String(s).padStart(2, &quot;0&quot;);\n  }\n  function rgba(hex, a) {\n    return &quot;rgba(&quot; + parseInt(hex.substr(1, 2), 16) + &quot;,&quot; + parseInt(hex.substr(3, 2), 16) + &quot;,&quot; + parseInt(hex.substr(5, 2), 16) + &quot;,&quot; + a + &quot;)&quot;;\n  }\n  function fmt(ms) {\n    if (ms === undefined || ms === null || isNaN(ms)) return &quot;--:--&quot;;\n    var t = Math.max(0, Math.ceil(ms / 1000));\n    var h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;\n    var mm = String(m).padStart(2, &quot;0&quot;), ss = String(s).padStart(2, &quot;0&quot;);\n    return h &gt; 0 ? h + &quot;:&quot; + mm + &quot;:&quot; + ss : mm + &quot;:&quot; + ss;\n  }\n\n  function applyConfig(c) {\n    try {\n      if (typeof c === &quot;string&quot;) c = JSON.parse(c);\n      if (c &amp;&amp; c.power &amp;&amp; (c.power.ftp || c.power.cp)) ftp = Number(c.power.ftp || c.power.cp) || ftp;\n      buildSegs(lastRoute);\n    } catch (e) { }\n  }\n\n  function applyRoute(r) {\n    try {\n      if (typeof r === &quot;string&quot;) r = JSON.parse(r);\n      if (!r || !r.workout) return;\n      lastRoute = r;\n      durationMs = Number(r.workout.duration_msecs) || durationMs;\n      var name = r.workout.name || r.workout.description || &quot;&quot;;\n      document.getElementById(&quot;title&quot;).innerText = (name || DEFAULT_TITLE).toUpperCase();\n      fitTitle();\n      lapLen = 0; lastLapRem = null; cur = null; nextAt = null; hideRecap(); hideNext(); intensityPct = 100; intensityCand = null; showIntensity();\n      buildSegs(r);\n    } catch (e) { }\n  }\n\n  // Break the planned profile into steps and ramps\n  function buildSegs(r) {\n    segs = [];\n    if (!r || !r.workout || !r.workout.profile || !r.workout.profile.length) return;\n    var raw = r.workout.profile, maxV = 0;\n    for (var i = 0; i &lt; raw.length; i++) maxV = Math.max(maxV, Number(raw[i][1]) || 0);\n    var k = (maxV &gt; 0 &amp;&amp; maxV &lt;= 5) ? (ftp || 200) : 1;          // profile given as fractions of FTP\n    var p = raw.map(function (q) { return [Number(q[0]) || 0, (Number(q[1]) || 0) * k]; });\n    for (var j = 0; j + 1 &lt; p.length; j++) {\n      var a = p[j], b = p[j + 1];\n      if (b[0] - a[0] &lt; 50) continue;                               // a jump, not a piece\n      var last = segs[segs.length - 1], slope = (b[1] - a[1]) / (b[0] - a[0]);\n      if (last &amp;&amp; Math.abs(last.e - a[0]) &lt; 50 &amp;&amp; Math.abs(last.w1 - a[1]) &lt; 1.5 &amp;&amp;\n          Math.abs((last.w1 - last.w0) / (last.e - last.s) - slope) &lt; 1e-5) { last.e = b[0]; last.w1 = b[1]; }\n      else segs.push({ s: a[0], e: b[0], w0: a[1], w1: b[1] });\n    }\n  }\n  function segAt(ms) {\n    for (var i = 0; i &lt; segs.length; i++) if (ms &gt;= segs[i].s &amp;&amp; ms &lt; segs[i].e) return segs[i];\n    return null;\n  }\n  function plannedAt(ms) {\n    var s = segAt(ms);\n    return s ? s.w0 + (s.w1 - s.w0) * (ms - s.s) / (s.e - s.s) : 0;\n  }\n\n  // ---------- Last interval recap ----------\n  function hideRecap() { clearTimeout(recapTimer); clearTimeout(recapDelay); document.getElementById(&quot;recap&quot;).classList.remove(&quot;show&quot;); }\n  // Averages are second by second over the whole lap (lap marker to lap marker), so steps inside the lap are\n  // weighted by how long they last; % = average power / average target\n  function zoneOf(w) {\n    if (!(ftp &gt; 0) || !(w &gt; 0)) return -1;\n    var p = w / ftp * 100, z = 0;\n    while (z &lt; ZONE_TOPS.length &amp;&amp; p &gt; ZONE_TOPS[z]) z++;\n    return z;\n  }\n\n  // ---------- Up Next ----------\n  function hideNext(quick) {\n    var el = document.getElementById(&quot;next&quot;);\n    if (quick) el.classList.add(&quot;out&quot;);\n    el.classList.remove(&quot;show&quot;); nextKey = &quot;&quot;;\n  }\n  // The interval starting at segment i as one block: keep reading ahead through surges and short dips until the\n  // power drops to recovery level (or drops a long way for a long time). &quot;from&quot; cuts off anything before the lap start.\n  function blockFrom(i, from) {\n    if (i &gt;= segs.length) return null;\n    var rec = ftp &gt; 0 ? ftp * RECOVERY_PCT / 100 : 0;\n    function avgOf(g) { return (g.w0 + g.w1) / 2; }\n    function isRec(g) { return rec &gt; 0 &amp;&amp; Math.max(g.w0, g.w1) &lt;= rec; }\n    var first = segs[i];\n    if (from !== undefined &amp;&amp; from &gt; first.s &amp;&amp; from &lt; first.e)        // lap starts partway through this step\n      first = { s: from, e: first.e, w0: first.w0 + (first.w1 - first.w0) * (from - first.s) / (first.e - first.s), w1: first.w1 };\n    var easy = isRec(first);\n    var b = { s: first.s, e: first.e, min: Math.min(first.w0, first.w1), max: Math.max(first.w0, first.w1), easy: easy,\n              sum: avgOf(first) * (first.e - first.s), n: 1, ramp: Math.abs(first.w1 - first.w0) &gt;= 3, up: true, down: true, last: avgOf(first) };\n    var j;\n    for (j = i + 1; j &lt; segs.length; j++) {\n      var g = segs[j];\n      if (Math.abs(g.s - b.e) &gt; 1000) break;                         // gap in the plan\n      if (easy) { if (!isRec(g)) break; }\n      else {\n        if (isRec(g)) break;                                         // back to recovery: the interval is over\n        var blockAvg = b.sum / (b.e - b.s);\n        if (avgOf(g) &lt; blockAvg * (1 - BIG_DROP_PCT / 100) &amp;&amp; g.e - g.s &gt;= BIG_DROP_SECS * 1000 &amp;&amp; b.e - b.s &gt;= BIG_DROP_SECS * 1000) break;   // (an opening surge doesn&apos;t count)\n        // A big jump after a steady stretch starts a new interval, unless it&apos;s a surge inside this one:\n        // power comes back to this interval&apos;s level afterwards, or it&apos;s a short, moderate kick at the very end\n        if (avgOf(g) &gt; blockAvg * (1 + BIG_DROP_PCT / 100) &amp;&amp; b.e - b.s &gt;= BIG_DROP_SECS * 1000) {\n          var nx = segs[j + 1];\n          var backToLevel = nx &amp;&amp; Math.abs(nx.s - g.e) &lt;= 1000 &amp;&amp; !isRec(nx) &amp;&amp; Math.abs(avgOf(nx) - blockAvg) &lt;= blockAvg * BIG_DROP_PCT / 100;\n          var endKick = g.e - g.s &lt;= SURGE_MAX_SECS * 1000 &amp;&amp; avgOf(g) &lt;= blockAvg * (1 + SURGE_MAX_PCT / 100);\n          if (!backToLevel &amp;&amp; !endKick) break;\n        }\n      }\n      if (avgOf(g) &lt; b.last - 1) b.up = false;\n      if (avgOf(g) &gt; b.last + 1) b.down = false;\n      b.last = avgOf(g);\n      b.e = g.e; b.sum += avgOf(g) * (g.e - g.s); b.n++;\n      b.min = Math.min(b.min, g.w0, g.w1); b.max = Math.max(b.max, g.w0, g.w1);\n    }\n    b.j = j;\n    b.avg = b.sum / (b.e - b.s);\n    return b;\n  }\n\n  // The next interval, starting exactly at the next lap (lapStart), read from the plan just past that point\n  function nextBlock(lapStart) {\n    var at = lapStart + NEXT_LOOK_PAST_MS, i = 0;\n    while (i &lt; segs.length &amp;&amp; !(at &gt;= segs[i].s &amp;&amp; at &lt; segs[i].e)) i++;\n    var b = blockFrom(i, lapStart);\n    if (!b) return null;\n    // Repeats: the same effort and the same rest over and over (like 6 x 40 seconds on, 20 seconds off)\n    b.reps = 1; b.rest = 0;\n    if (!b.easy &amp;&amp; b.n === 1) {          // only simple single-power efforts count as repeats\n      var k = b.j, lastE = b.e;\n      function close(x, y) {\n        return Math.abs(x - y) &lt;= Math.min(REPEAT_MAX_SECS * 1000, Math.max(REPEAT_MATCH_SECS * 1000, Math.min(x, y) * REPEAT_MATCH_PCT / 100));\n      }\n      while (true) {\n        var r = blockFrom(k);\n        if (!r || !r.easy || Math.abs(r.s - lastE) &gt; 1000) break;\n        var h = blockFrom(r.j);\n        if (!h || h.easy || h.n !== 1 || Math.abs(h.s - r.e) &gt; 1000) break;\n        var same = close(h.e - h.s, b.e - b.s) &amp;&amp; Math.abs(h.min - b.min) &lt;= 3 &amp;&amp; Math.abs(h.max - b.max) &lt;= 3;\n        var restLen = r.e - r.s;\n        if (!same || (b.reps &gt; 1 &amp;&amp; !close(restLen, b.rest))) break;\n        if (b.reps === 1) b.rest = restLen;\n        b.reps++; k = h.j; lastE = h.e;\n      }\n    }\n    return b;\n  }\n\n  // Called about 10 times a second with the smoothed countdown (est). The countdown only decides when the panel\n  // shows; what it shows always comes from nextAt, which is set from one telemetry update, so the two can&apos;t drift apart.\n  function updateNext(est) {\n    var secs = est / 1000;\n    if (secs &gt; NEXT_SHOW_SECS || secs &lt;= NEXT_HIDE_SECS || nextAt === null || curPos === null) {\n      if (document.getElementById(&quot;next&quot;).classList.contains(&quot;show&quot;)) hideNext(secs &lt;= NEXT_HIDE_SECS);\n      return;\n    }\n    var b = nextBlock(nextAt);\n    if (!b) return;\n    // Follow the intensity setting: scale the plan the same way GoldenCheetah is scaling the current target\n    var k = 1, planNow = plannedAt(curPos);\n    if (lastTarget &gt; 0 &amp;&amp; planNow &gt; 0) k = lastTarget / planNow;\n    if (Math.abs(k - 1) &lt; 0.01) k = 1;\n    var lo = Math.round(b.min * k), hi = Math.round(b.max * k), avg = Math.round(b.avg * k);\n    var key = [b.s, b.e, lo, hi, b.reps].join(&quot;,&quot;);\n    if (key !== nextKey) {                                     // fill in (again only if something changed)\n      nextKey = key;\n      var steady = hi - lo &lt; 3, single = b.n === 1;\n      var nw = document.getElementById(&quot;nw&quot;);\n      nw.innerText = steady ? lo : lo + &quot;-&quot; + hi;\n      nw.style.fontSize = steady ? &quot;&quot; : &quot;calc(var(--v) * 0.6)&quot;;\n      var nt = document.getElementById(&quot;nt&quot;);\n      nt.innerText = (b.reps &gt; 1 ? b.reps + &quot;× &quot; : &quot;&quot;) + fmtLen(b.e - b.s);\n      nt.style.fontSize = b.reps &gt; 1 ? &quot;calc(var(--v) * 0.42)&quot; : &quot;&quot;;\n      var z = zoneOf(avg), col = z &gt;= 0 ? ZONE_COLORS[z] : &quot;#ffffff&quot;;\n      var st = document.documentElement.style;\n      st.setProperty(&quot;--zc&quot;, col); st.setProperty(&quot;--zb&quot;, rgba(col, 0.16)); st.setProperty(&quot;--zg&quot;, rgba(col, 0.35));\n      var sub = &quot;&quot;;\n      if (ftp &gt; 0) {\n        var P = function (w) { return Math.round(w / ftp * 100); };\n        if (b.reps &gt; 1) sub = fmtLen(b.rest) + &quot; REST   &quot; + (steady ? P(lo) + &quot;% FTP&quot; : &quot;AVG &quot; + P(avg) + &quot;% FTP&quot;);\n        else if (steady) sub = P(lo) + &quot;% FTP   &quot; + ZONE_NAMES[z];\n        else if (single &amp;&amp; b.ramp) sub = &quot;RAMP  &quot; + P(lo) + &quot;-&quot; + P(hi) + &quot;% FTP&quot;;\n        else sub = (b.up ? &quot;BUILDING&quot; : (b.down ? &quot;EASING&quot; : &quot;SURGES&quot;)) + &quot;   AVG &quot; + P(avg) + &quot;% FTP&quot;;\n      }\n      document.getElementById(&quot;nsub&quot;).innerText = sub;\n    }\n    var el = document.getElementById(&quot;next&quot;);\n    if (!el.classList.contains(&quot;show&quot;)) { el.classList.remove(&quot;out&quot;); el.classList.add(&quot;show&quot;); }\n  }\n\n  function finishInterval() {\n    var c = cur; cur = null;\n    if (!c || !c.full || Math.ceil(c.len / 1000 - 0.05) &lt; RECAP_MIN_SECS || !(c.pT &gt; 0)) return;\n    var avgP = c.p / c.pT, avgT = c.tT &gt; 0 ? c.t / c.tT : 0;\n    var pct = avgT &gt; 0 ? avgP / avgT * 100 : null;\n    document.getElementById(&quot;rw&quot;).innerText = Math.round(avgP);\n    document.getElementById(&quot;rpct&quot;).innerText = pct === null ? &quot;&quot; : Math.round(pct) + &quot;%&quot;;\n    var col = pct === null ? &quot;#ffffff&quot; : (Math.abs(pct - 100) &lt;= ON_TARGET_PCT ? &quot;#00d64f&quot; : (pct &gt; 100 ? &quot;#ff6a00&quot; : &quot;#29c5ff&quot;));\n    document.documentElement.style.setProperty(&quot;--rc&quot;, col);\n    document.documentElement.style.setProperty(&quot;--rb&quot;, rgba(col, 0.12));\n    document.getElementById(&quot;rlab&quot;).innerText = &quot;LAST  &quot; + fmtLen(c.dur) + (avgT &gt; 0 ? &quot; @ &quot; + Math.round(avgT) + &quot; W&quot; : &quot;&quot;);\n    var parts = [];\n    if (c.hT &gt; 0) parts.push(&apos;&lt;span class=&quot;hr&quot;&gt;&apos; + Math.round(c.h / c.hT) + &apos;&lt;/span&gt; BPM&apos;);\n    if (c.cT &gt; 0) parts.push(&apos;&lt;span class=&quot;cad&quot;&gt;&apos; + Math.round(c.c / c.cT) + &apos;&lt;/span&gt; RPM&apos;);\n    document.getElementById(&quot;rsub&quot;).innerHTML = parts.join(&quot;     &quot;);\n    hideRecap();\n    recapDelay = setTimeout(function () {\n      document.getElementById(&quot;recap&quot;).classList.add(&quot;show&quot;);\n      recapTimer = setTimeout(hideRecap, RECAP_SHOW_SECS * 1000);\n    }, RECAP_DELAY_SECS * 1000);\n  }\n\n  // ---------- Telemetry ----------\n  function num(d, keys) {\n    for (var i = 0; i &lt; keys.length; i++) if (d[keys[i]] !== undefined &amp;&amp; !isNaN(Number(d[keys[i]]))) return Number(d[keys[i]]);\n    return undefined;\n  }\n\n  function onData(d) {\n    var now = Date.now();\n    var pos = num(d, [&quot;Current Position&quot;, &quot;Time&quot;]);\n    if (pos !== undefined) curPos = pos;\n    var left = (durationMs &gt; 0 &amp;&amp; pos !== undefined) ? Math.max(0, durationMs - pos) : undefined;\n    document.getElementById(&quot;wleft&quot;).innerText = fmt(left);\n    document.getElementById(&quot;wfill&quot;).style.width = (durationMs &gt; 0 &amp;&amp; left !== undefined ? (1 - left / durationMs) * 100 : 0) + &quot;%&quot;;\n    var tg = num(d, [&quot;Target Power&quot;]);\n    if (tg !== undefined) lastTarget = tg;\n    checkIntensity(tg, pos);\n\n    // Interval stats, counted only while the workout moves forward normally\n    if (cur &amp;&amp; pos !== undefined &amp;&amp; lastPosSeen !== null) {\n      var dp = pos - lastPosSeen, dw = now - lastWall;\n      if (dp &gt; 0 &amp;&amp; dp &lt; 5000) {\n        if (dw &gt; 0 &amp;&amp; Math.abs(dp - dw) &gt; 2500) cur.full = false;   // skipped ahead\n        var w = dp / 1000;\n        cur.dur += dp;\n        var P = num(d, [&quot;Power&quot;]), H = num(d, [&quot;Heart Rate&quot;]), C = num(d, [&quot;Cadence&quot;]);\n        if (P !== undefined) { cur.p += P * w; cur.pT += w; }\n        if (tg &gt; 0) { cur.t += tg * w; cur.tT += w; }\n        if (H &gt; 0) { cur.h += H * w; cur.hT += w; }\n        if (C &gt; 0) { cur.c += C * w; cur.cT += w; }\n      } else if (dp &lt; 0 || dp &gt;= 5000) cur.full = false;            // rewound or jumped\n    }\n    var prevPos = lastPosSeen;\n    if (pos !== undefined) { lastPosSeen = pos; lastWall = now; }\n\n\n    // Next marked lap (from the LAP markers in the workout file); falls back to the next ERG section\n    var rem = num(d, [&quot;Lap Time Remaining&quot;, &quot;Section Time Remaining&quot;]);\n    var tl = document.getElementById(&quot;tl&quot;);\n    if (rem === undefined) { document.getElementById(&quot;lleft&quot;).innerText = &quot;--:--&quot;; tl.className = &quot;t&quot;; remMs = null; return; }\n    if (lastLapRem === null || rem &gt; lastLapRem + 1500) {           // a new interval started\n      var natural = lastLapRem !== null &amp;&amp; lastLapRem &lt; 3000;       // the last one ran out (not a skip)\n      if (natural) finishInterval();\n      hideNext(true);\n      lapLen = rem;\n      // Full planned length: what&apos;s left, plus the part that already passed before this update arrived\n      var into = (natural &amp;&amp; pos !== undefined &amp;&amp; prevPos !== null) ? Math.max(0, (pos - prevPos) - lastLapRem) : 0;\n      cur = { len: rem + Math.min(into, 2000), dur: 0, p: 0, pT: 0, t: 0, tT: 0, h: 0, hT: 0, c: 0, cT: 0, full: natural };\n    }\n    lastLapRem = rem;\n    remMs = rem; remAt = now;\n    nextAt = (pos !== undefined) ? pos + rem : null;              // same update for both, so this is the true lap edge\n    document.getElementById(&quot;lleft&quot;).innerText = fmt(rem);\n    document.getElementById(&quot;lfill&quot;).style.width = (lapLen &gt; 0 ? Math.min(100, (1 - rem / lapLen) * 100) : 0) + &quot;%&quot;;\n    var secs = rem / 1000;\n    tl.className = &quot;t&quot; + (secs &gt; 0 &amp;&amp; secs &lt;= LAST_SECS ? &quot; warn last&quot; : (secs &gt; 0 &amp;&amp; secs &lt;= WARN_SECS ? &quot; warn&quot; : &quot;&quot;));\n  }\n\n  function onState(s) {\n    s = String(s || &quot;&quot;).toLowerCase();\n    if (s.indexOf(&quot;pause&quot;) &gt;= 0 || s.indexOf(&quot;stop&quot;) &gt;= 0) running = false;\n    else if (s.indexOf(&quot;start&quot;) &gt;= 0 || s.indexOf(&quot;resume&quot;) &gt;= 0) running = true;\n  }\n\n  // ---------- Intensity: GoldenCheetah scales the targets in 5% steps; compare them with the plan ----------\n  var intensityPct = 100, intensityCand = null;\n  function checkIntensity(tg, pos) {\n    if (!SHOW_INTENSITY || !(tg &gt; 0) || pos === undefined || !segs.length) return;\n    var plan = plannedAt(pos);\n    if (!(plan &gt; 0)) return;\n    var pct = Math.round(tg / plan * 20) * 5;\n    if (pct === intensityCand &amp;&amp; pct !== intensityPct) { intensityPct = pct; showIntensity(); }   // two readings in a row agree\n    intensityCand = pct;\n  }\n  function showIntensity() {\n    var el = document.getElementById(&quot;intensity&quot;);\n    var on = SHOW_INTENSITY &amp;&amp; (intensityPct &lt; 100 || (INTENSITY_SHOW_HIGHER &amp;&amp; intensityPct &gt; 100));\n    el.innerText = on ? &quot;INTENSITY &quot; + (intensityPct &lt; 100 ? &quot;LOWERED&quot; : &quot;RAISED&quot;) + &quot; TO &quot; + intensityPct + &quot;%&quot; : &quot;&quot;;\n    el.style.display = on ? &quot;block&quot; : &quot;none&quot;;\n    fitTitle();\n  }\n\n  // ---------- Countdown sound: 4, 3, 2, 1 beeps, then a slightly longer beep ----------\n  var audio = null, master = null, cdKey = null, cdDone = {}, cdNodes = [];\n  var soundOn = COUNTDOWN_SOUND;\n  var ICON_SPEAKER = &apos;&lt;path d=&quot;M3.5 9.2h3.8l5-4.2v14l-5-4.2H3.5z&quot; fill=&quot;currentColor&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;1.2&quot; stroke-linejoin=&quot;round&quot;/&gt;&apos;;\n  var ICON_ON = &apos;&lt;svg viewBox=&quot;0 0 24 24&quot;&gt;&apos; + ICON_SPEAKER +\n    &apos;&lt;path d=&quot;M15.6 8.6a4.8 4.8 0 0 1 0 6.8M18.3 5.9a8.6 8.6 0 0 1 0 12.2&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;1.8&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;/svg&gt;&apos;;\n  var ICON_OFF = &apos;&lt;svg viewBox=&quot;0 0 24 24&quot;&gt;&apos; + ICON_SPEAKER +\n    &apos;&lt;path d=&quot;M3.5 3.5l17 17&quot; stroke=&quot;#000&quot; stroke-width=&quot;4.2&quot; stroke-linecap=&quot;round&quot;/&gt;&apos; +\n    &apos;&lt;path d=&quot;M3.5 3.5l17 17&quot; stroke=&quot;#ff1f3d&quot; stroke-width=&quot;2.2&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;/svg&gt;&apos;;\n  var shownState = null;\n  function updateSoundButton() {\n    var b = document.getElementById(&quot;sound&quot;);\n    var state = !soundOn ? &quot;off&quot; : (audio &amp;&amp; audio.state === &quot;running&quot;) ? &quot;on&quot; : &quot;blocked&quot;;\n    if (state === shownState) return;\n    shownState = state;\n    b.className = state;\n    document.getElementById(&quot;sw&quot;).className = state;\n    b.innerHTML = state === &quot;off&quot; ? ICON_OFF : ICON_ON;\n    b.title = state === &quot;off&quot; ? &quot;Countdown beeps off (click to turn on)&quot; :\n              state === &quot;on&quot; ? &quot;Countdown beeps on (click to turn off)&quot; : &quot;Countdown beeps on, but sound is blocked (click to allow sound)&quot;;\n  }\n  function audioOn() {\n    if (!soundOn) return null;\n    try {\n      if (!audio) {\n        var AC = window.AudioContext || window.webkitAudioContext;\n        if (!AC) return null;\n        audio = new AC();\n        var comp = audio.createDynamicsCompressor();\n        master = audio.createGain(); master.gain.value = COUNTDOWN_VOLUME;\n        master.connect(comp); comp.connect(audio.destination);\n        audio.onstatechange = updateSoundButton;\n      }\n      if (audio.state === &quot;suspended&quot;) audio.resume();\n    } catch (e) { return null; }\n    updateSoundButton();\n    return audio;\n  }\n  // Speaker button: turns the beeps on and off. If the beeps are on but the sound is still blocked, a click only allows the sound.\n  var wasBlocked = false;\n  document.getElementById(&quot;sound&quot;).addEventListener(&quot;pointerdown&quot;, function () {\n    wasBlocked = soundOn &amp;&amp; !(audio &amp;&amp; audio.state === &quot;running&quot;);\n  });\n  document.getElementById(&quot;sound&quot;).addEventListener(&quot;click&quot;, function () {\n    if (wasBlocked) { wasBlocked = false; audioOn(); return; }\n    soundOn = !soundOn;\n    if (!soundOn) cancelCountdown(); else audioOn();\n    updateSoundButton();\n  });\n  audioOn(); updateSoundButton();   // show the button right away (on, off, or blocked)\n  // Sound is often blocked until the page is clicked once\n  [&quot;pointerdown&quot;, &quot;keydown&quot;, &quot;click&quot;].forEach(function (ev) { document.addEventListener(ev, function () { audioOn(); setTimeout(audioOn, 200); }); });\n\n  function keep(n) { cdNodes.push(n); return n; }\n  function beep(at, freq, len) {\n    var o = keep(audio.createOscillator()), g = audio.createGain();\n    o.type = &quot;triangle&quot;; o.frequency.value = freq;\n    g.gain.setValueAtTime(0.0001, at);\n    g.gain.exponentialRampToValueAtTime(0.9, at + 0.008);\n    g.gain.setValueAtTime(0.9, at + Math.max(0.01, len - 0.1));        // hold, then fade over the last 0.1 s\n    g.gain.exponentialRampToValueAtTime(0.0001, at + len);\n    o.connect(g); g.connect(master); o.start(at); o.stop(at + len + 0.05);\n  }\n  function cancelCountdown() {\n    cdNodes.forEach(function (n) { try { n.stop(); } catch (e) { } });\n    cdNodes = [];\n  }\n  // Called about 10 times a second with the estimated time left in this lap\n  function countdownTick(est) {\n    if (!soundOn || remMs === null || curPos === null) return;\n    var key = Math.round((curPos + remMs) / 1000);   // which lap boundary we&apos;re counting down to\n    if (cdKey === null || Math.abs(key - cdKey) &gt; 2) { cdKey = key; cdDone = {}; }   // a new boundary (small wobble is the same one)\n    if (!running) { cancelCountdown(); return; }\n    if (est &gt; COUNTDOWN_FROM * 1000 + 300) return;\n    if (!COUNTDOWN_ALL_LAPS) {\n      var w = plannedAt(curPos + est + 500);\n      if (ftp &gt; 0 &amp;&amp; w &gt; 0 &amp;&amp; w &lt;= ftp * RECOVERY_PCT / 100) return;   // no countdown into a recovery\n    }\n    var ctx = audioOn();\n    if (!ctx || ctx.state !== &quot;running&quot;) return;\n    for (var k = COUNTDOWN_FROM; k &gt;= 0; k--) {\n      if (cdDone[k]) continue;\n      var due = est - k * 1000;                        // ms until this sound\n      if (due &lt; -400) { cdDone[k] = true; continue; }  // already passed (skipped ahead)\n      if (due &gt; 150) continue;                         // not yet; schedule it on a later tick\n      cdDone[k] = true;\n      var at = ctx.currentTime + Math.max(0, due) / 1000;\n      beep(at, 880, k &gt; 0 ? COUNTDOWN_BEEP_SECS : COUNTDOWN_LAST_SECS);\n    }\n  }\n\n  setInterval(function () {\n    if (remMs === null) return;\n    var est = running ? Math.max(0, remMs - Math.min(1500, Date.now() - remAt)) : remMs;\n    updateNext(est);\n    countdownTick(est);\n  }, 100);\n\n  window.addEventListener(&quot;resize&quot;, size);\n  window.onload = function () {\n    size();\n    audioOn();\n    if (typeof QWebChannel !== &quot;undefined&quot; &amp;&amp; window.qt &amp;&amp; qt.webChannelTransport) {\n      new QWebChannel(qt.webChannelTransport, function (channel) {\n        var gc = channel.objects.gc;\n        if (gc &amp;&amp; gc.getConfig) { var q0 = gc.getConfig(applyConfig); if (q0 &amp;&amp; q0.then) q0.then(applyConfig); }\n        if (gc &amp;&amp; gc.getPlannedRoute) { var q = gc.getPlannedRoute(applyRoute); if (q &amp;&amp; q.then) q.then(applyRoute); }\n        if (gc &amp;&amp; gc.plannedRouteChanged) gc.plannedRouteChanged.connect(applyRoute);\n        if (gc &amp;&amp; gc.stateChanged) gc.stateChanged.connect(onState);\n        if (gc &amp;&amp; gc.telemetry) gc.telemetry.connect(function (p) { onData(typeof p === &quot;string&quot; ? JSON.parse(p) : (p || {})); });\n      });\n    } else {\n      // Browser preview: 10 min warm up, then 1:00 hard / 0:40 easy repeats, in real time\n      document.getElementById(&quot;status&quot;).innerText = &quot;Preview (simulated data)&quot;;\n      ftp = 220;\n      var prof = [[0, 100], [600000, 180]], t = 600000, laps = [600000];\n      for (var i = 0; i &lt; 8; i++) {\n        prof.push([t, 280], [t + 60000, 280], [t + 60000, 130], [t + 100000, 130]);\n        laps.push(t + 60000, t + 100000); t += 100000;\n      }\n      prof.push([t, 130], [t + 300000, 100]); laps.push(t + 300000);\n      applyRoute({ workout: { name: &quot;Revolver Remastered&quot;, duration_msecs: t + 300000, profile: prof } });\n      var hp = location.hash.match(/pos=([0-9]+)/), speed = Number((location.hash.match(/speed=([0-9]+)/) || [])[1]) || 1;\n      var sp = hp ? Number(hp[1]) : 600000 - 40000, start = Date.now();\n      setInterval(function () {\n        var pos = sp + (Date.now() - start) * speed;\n        var nextLap = laps.filter(function (x) { return x &gt; pos; })[0] || t + 300000;\n        var tgt = plannedAt(pos);\n        if (speed &gt; 1) lastWall = Date.now() - 250 * speed;          // keep sped-up previews counting as normal riding\n        onData({ &quot;Current Position&quot;: pos, &quot;Lap Time Remaining&quot;: nextLap - pos, &quot;Target Power&quot;: tgt,\n          &quot;Power&quot;: tgt * (0.97 + Math.random() * 0.08), &quot;Heart Rate&quot;: 150 + Math.random() * 3, &quot;Cadence&quot;: 90 + Math.random() * 4 });\n      }, 250);\n    }\n  };\n&lt;/script&gt;\n&lt;/body&gt;\n&lt;/html&gt;" />
		<property name="splitterState" type="QByteArray" value="" />
		<property name="showEditor" type="bool" value="0" />
		<property name="chartConfig" type="QString" value="" />
		<property name="showTitleBar" type="bool" value="0" />
	</chart>
	<chart id="58" name="" title="Magnified Workout" >
		<property name="title" type="QString" value="Magnified Workout" />
		<property name="subtitle" type="QString" value="" />
		<property name="widthFactor" type="double" value="1" />
		<property name="heightFactor" type="double" value="3.84615" />
		<property name="style" type="int" value="2" />
		<property name="resizable" type="bool" value="1" />
		<property name="html" type="QString" value="&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n&lt;meta charset=&quot;utf-8&quot;&gt;\n&lt;title&gt;Magnified Workout&lt;/title&gt;\n&lt;script src=&quot;qrc:///qtwebchannel/qwebchannel.js&quot;&gt;&lt;/script&gt;\n&lt;style&gt;\n  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #000; }\n  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n  #debug { position: fixed; left: 0; right: 0; bottom: 0; display: none; padding: 4px 8px; background: rgba(0,0,0,0.8);\n    font: 11px Consolas, monospace; color: #9ef; white-space: normal; max-height: 60%; overflow: auto; }\n  /* Message center: coaching messages from the workout file, centered over the chart */\n  #msgwrap { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }\n  #msg { max-width: 72%; box-sizing: border-box; padding: 0.45em 1.1em; border-radius: 0.7em; text-align: center;\n    font: 700 22px -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; letter-spacing: 0.02em; line-height: 1.25; color: #fff;\n    background: rgba(0,0,0,0.12); border: 1px solid rgba(255,255,255,0.18);\n    box-shadow: none;\n    text-shadow: 0 0 2px #000, 0 0 3px #000, 0 1px 6px rgba(0,0,0,0.9), 0 0 14px rgba(0,0,0,0.6);   /* dark edge keeps the text readable on any color */\n    opacity: 0; transform: translateY(6px) scale(0.98); transition: opacity 0.6s ease, transform 0.6s ease; }\n  #msg.show { opacity: 1; transform: none; transition: opacity 0.35s ease, transform 0.35s ease; }\n  /* Legend: one compact line in the upper left (PWR | HR | W&apos;), nearly solid black so it stays readable over the chart */\n  #legend { position: absolute; left: 6px; top: 6px; z-index: 5; pointer-events: none; box-sizing: border-box;\n    padding: 0.2em 0.6em; border-radius: 0.5em; background: rgba(0,0,0,0.85); border: 1px solid rgba(255,255,255,0.18);\n    font: 700 clamp(10px, 0.6vw, 14px) -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; letter-spacing: 0.06em; line-height: 1.3;\n    display: none; align-items: center; white-space: nowrap; }\n  #legend .it { display: inline-flex; align-items: center; gap: 0.35em; }\n  #legend .sep { width: 1px; height: 0.95em; background: rgba(255,255,255,0.55); margin: 0 0.6em; flex: none; }\n  #legend svg { width: 2.2em; height: 0.85em; overflow: visible; flex: none; }\n  #legend .wb { display: inline-block; -webkit-background-clip: text; background-clip: text; color: transparent; }\n  /* Zoom slider: top middle, same black box as the legend. Drag to show 1 to 15 minutes of the workout */\n  #zoom { position: absolute; left: 50%; top: 6px; transform: translateX(-50%); z-index: 7; box-sizing: border-box;\n    display: none; align-items: center; gap: 0.55em; padding: 0.2em 0.7em; border-radius: 0.5em;\n    background: rgba(0,0,0,0.85); border: 1px solid rgba(255,255,255,0.18);\n    font: 700 clamp(10px, 0.6vw, 14px) -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; letter-spacing: 0.06em; line-height: 1.3;\n    color: rgba(255,255,255,0.75); white-space: nowrap; }\n  #zoom .ic { width: 1.15em; height: 1.15em; flex: none; cursor: pointer; }\n  #zoom .val { color: #fff; font-variant-numeric: tabular-nums; min-width: 2.9em; text-align: right; }\n  #zoom input { -webkit-appearance: none; appearance: none; width: 11em; height: 0.35em; border-radius: 0.2em; margin: 0; cursor: pointer;\n    background: linear-gradient(90deg, rgba(255,255,255,0.85) var(--p), rgba(255,255,255,0.18) var(--p)); outline: none; }\n  #zoom input::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 1.05em; height: 1.05em; border-radius: 50%; background: #fff;\n    box-shadow: 0 0 0 2px rgba(0,0,0,0.65), 0 0 6px rgba(255,255,255,0.5); }\n  /* Paused message */\n  #pausewrap { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 6; }\n  #paused { font: 800 calc(var(--wh) * 0.2) -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; letter-spacing: 0.25em; color: #fff;\n    padding: 0.12em 0.45em 0.12em 0.7em; border-radius: 0.22em; background: rgba(0,0,0,0.12); border: 1px solid rgba(255,255,255,0.2);\n    text-shadow: 0 0 2px #000, 0 0 4px #000, 0 2px 10px rgba(0,0,0,0.9); opacity: 0; transition: opacity 0.4s ease; }\n  #paused.show { opacity: 1; animation: breathe 2.4s ease-in-out infinite; }\n  @keyframes breathe { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }\n  body.paused #msgwrap { opacity: 0; }\n  #status { position: fixed; top: 2px; right: 6px; font: 10px -apple-system, &quot;Segoe UI&quot;, Arial, sans-serif; color: rgba(255,255,255,0.4); }\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n&lt;canvas id=&quot;c&quot;&gt;&lt;/canvas&gt;\n&lt;div id=&quot;legend&quot;&gt;&lt;/div&gt;\n&lt;div id=&quot;zoom&quot;&gt;&lt;/div&gt;\n&lt;div id=&quot;msgwrap&quot;&gt;&lt;div id=&quot;msg&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;div id=&quot;pausewrap&quot;&gt;&lt;div id=&quot;paused&quot;&gt;PAUSED&lt;/div&gt;&lt;/div&gt;\n&lt;div id=&quot;status&quot;&gt;&lt;/div&gt;\n&lt;div id=&quot;debug&quot;&gt;&lt;/div&gt;\n&lt;script&gt;\n  // ---------- Dropout guard ----------\n  var HOLD_SECS = 2;   // a reading that briefly drops out (missing, or a sudden 0) keeps its last value this long\n  var _held = {};\n  function heldNum(d, keys, name) {\n    var v, i, now = Date.now();\n    for (i = 0; i &lt; keys.length; i++) if (d[keys[i]] !== undefined &amp;&amp; d[keys[i]] !== null &amp;&amp; d[keys[i]] !== &quot;&quot;) { v = Number(d[keys[i]]); break; }\n    var h = _held[name] || (_held[name] = { v: 0, at: 0 });\n    if (v === undefined || isNaN(v)) return h.v;                       // not in this update: keep the last value\n    if (v &gt; 0) { h.v = v; h.at = now; return v; }\n    if (h.v &gt; 0 &amp;&amp; now - h.at &lt; HOLD_SECS * 1000 + 500) return h.v;    // a short dropout: keep showing the last value\n    h.v = v; return v;\n  }\n  // ---------- Settings ----------\n  // Workout is colored by the target&apos;s power zone (% of FTP), fading over 3 percentage points at each boundary\n  var ZONE_COLORS = [&quot;#29c5ff&quot;, &quot;#0066ff&quot;, &quot;#00d64f&quot;, &quot;#ffd400&quot;, &quot;#ff6a00&quot;, &quot;#ff1f3d&quot;]; // Z1 recovery .. Z6/7 anaerobic and sprint\n  var CORNER_RADIUS = 10;          // rounding on the workout&apos;s corners, in pixels (0 = square)\n  var ZONE_TOPS = [55.5, 75.5, 90.5, 105.5, 120.5];  // zone boundaries in % FTP (Z1 &lt;=55, Z2 56-75, Z3 76-90, Z4 91-105, Z5 106-120, Z6+ &gt;120)\n  var FADE_PCT = 3;                // width of each color fade, in % FTP\n  var LINE_OUTLINE = &quot;rgba(0,0,0,0.65)&quot;;  // thin dark edge so the lines stay visible on yellow and red blocks\n  var POWER_COLOR = &quot;#ffe94d&quot;;     // power line\n  var POWER_WIDTH = 1.5;           // power line thickness (px)\n  var HR_COLOR = &quot;#ff2a2a&quot;;        // heart rate line\n  var HR_WIDTH = 1.5;              // heart rate line thickness (px)\n  var WBAL_SOURCE = &quot;calculated&quot;;  // W&apos; balance line: &quot;calculated&quot; = same formula as GoldenCheetah&apos;s Activities W&apos; bal (and the battery gauge)\n                                   //    &quot;goldencheetah&quot; = GoldenCheetah&apos;s own live number (recovers faster)\n  var WBAL_WIDTH = 2;               // W&apos; balance line thickness (px); colored by how full it is, like the battery\n  var WBAL_LEVELS = [[0, &quot;#ff1f3d&quot;], [15, &quot;#ff1f3d&quot;], [30, &quot;#ff6a00&quot;], [50, &quot;#ffd400&quot;], [70, &quot;#00d64f&quot;], [100, &quot;#00d64f&quot;]];\n  var SHOW_ZOOM = true;            // zoom slider at the top middle\n  var ZOOM_DEFAULT_MINS = 3;       // minutes of workout shown when the perspective loads (half behind &quot;now&quot;, half ahead)\n  var ZOOM_MIN_MINS = 1;           // slider all the way left (most magnified)\n  var ZOOM_MAX_MINS = 15;          // slider all the way right (most zoomed out)\n  var ZOOM_STEP_SECS = 15;         // the window length moves in steps of this many seconds\n  var CENTER_COLOR = &quot;rgba(255,255,255,0.35)&quot;;  // thin line marking &quot;now&quot; (set to &quot;&quot; to hide)\n  var SHOW_MESSAGES = true;        // message center: show coaching messages from the workout file\n  var MSG_SIZE = 0.11;             // message text size, as a share of the chart height\n  var SHOW_PAUSED = true;          // big &quot;PAUSED&quot; over the chart while the workout is paused\n  var SHOW_TIME_MARKS = true;      // small workout-clock labels along the bottom\n  var TIME_MARK_SECS = 0;          // seconds between labels; 0 = automatic for the zoom (10 s at 1:00, 30 s at 3:00, 2 min at 15:00)\n  var TIME_MARK_MAX = 8;           // automatic labels: no more than about this many across the chart\n  var TIME_MARK_SIZE = 11;         // label text size, in pixels\n  var TIME_MARK_COLOR = &quot;rgba(255,255,255,0.85)&quot;;\n  var SHOW_LEGEND = true;          // one-line legend in the upper left (PWR, HR, W&apos;)\n  var SMOOTH_SECS = 3;             // power smoothing: average of the last 3 seconds (0 = raw); heart rate is not smoothed\n\n  var HALF_MS = ZOOM_DEFAULT_MINS * 30000;   // time shown either side of now, in ms (set by the zoom slider)\n  var profile = [];      // [[msecs, watts], ...]\n  var durationMs = 0;\n  var ftp = 0;\n  var samples = [];      // [[msecs, watts, bpm], ...]\n  var smoothBuf = [];\n  var lastTime = -1;\n  var dirty = true;\n  var running = false, lastWall = 0;\n  var disp = null, lastFrame = 0;   // position drawn at the center: glides with the clock and eases into each update, never stepping back\n\n  var canvas = document.getElementById(&quot;c&quot;);\n  var ctx = canvas.getContext(&quot;2d&quot;);\n\n  function resize() {\n    document.documentElement.style.setProperty(&quot;--wh&quot;, window.innerHeight + &quot;px&quot;);\n    var r = window.devicePixelRatio || 1;\n    canvas.width = Math.max(1, Math.round(window.innerWidth * r));\n    canvas.height = Math.max(1, Math.round(window.innerHeight * r));\n    dirty = true;\n  }\n\n  function applyConfig(c) {\n    try {\n      if (typeof c === &quot;string&quot;) c = JSON.parse(c);\n      if (c &amp;&amp; c.power &amp;&amp; (c.power.ftp || c.power.cp)) ftp = Number(c.power.ftp || c.power.cp) || 0;\n      if (c &amp;&amp; c.power &amp;&amp; c.power.wprime) wprime = Math.max(wprime, Number(c.power.wprime) || 0);\n      if (c &amp;&amp; c.power &amp;&amp; (c.power.cp || c.power.ftp)) cp = Number(c.power.cp || c.power.ftp) || cp;\n    } catch (e) { }\n    normaliseProfile();\n    dirty = true;\n  }\n\n  var rawProfile = null;\n  function applyRoute(r) {\n    try {\n      if (typeof r === &quot;string&quot;) r = JSON.parse(r);\n      if (!r || !r.workout) return;\n      rawProfile = r.workout.profile || null;\n      durationMs = Number(r.workout.duration_msecs) || 0;\n      normaliseProfile();\n      samples = []; lastTime = -1;\n      dirty = true;\n    } catch (e) { }\n  }\n\n  // Accept watts, or fractions of FTP if every value is small\n  function normaliseProfile() {\n    if (!rawProfile || !rawProfile.length) return;\n    var maxV = 0;\n    for (var i = 0; i &lt; rawProfile.length; i++) maxV = Math.max(maxV, Number(rawProfile[i][1]) || 0);\n    var k = (maxV &gt; 0 &amp;&amp; maxV &lt;= 5) ? (ftp || 200) : 1;\n    profile = rawProfile.map(function (p) { return [Number(p[0]) || 0, (Number(p[1]) || 0) * k]; });\n    if (!durationMs) durationMs = profile[profile.length - 1][0];\n  }\n\n  // Where we are in the workout. Elapsed &quot;Time&quot; keeps counting normally when you skip ahead,\n  // so use the workout position instead.\n  var REMAIN_KEYS = [&quot;Ergo Time Remaining&quot;, &quot;Workout Time Remaining&quot;, &quot;Erg Time Remaining&quot;, &quot;Total Time Remaining&quot;];\n  // GoldenCheetah sends the workout position in milliseconds as &quot;Current Position&quot;;\n  // it jumps when you fast forward or rewind, unlike &quot;Time&quot;.\n  var POS_KEYS = [&quot;Current Position&quot;, &quot;Workout Time&quot;, &quot;Ergo Time&quot;];\n  var lastKeys = {};\n\n  function workoutPos(d) {\n    var i, v;\n    for (i = 0; i &lt; POS_KEYS.length; i++) {\n      v = d[POS_KEYS[i]];\n      if (v !== undefined &amp;&amp; !isNaN(Number(v))) return Number(v);\n    }\n    if (durationMs &gt; 0) {\n      for (i = 0; i &lt; REMAIN_KEYS.length; i++) {\n        v = d[REMAIN_KEYS[i]];\n        if (v !== undefined &amp;&amp; !isNaN(Number(v))) return Math.max(0, durationMs - Number(v));\n      }\n    }\n    v = Number(d[&quot;Time&quot;]);\n    return isNaN(v) ? null : v;\n  }\n\n  // GoldenCheetah sends the current message as &quot;notification_text&quot; for as long as it should show\n  var msgText = &quot;&quot;;\n  function showMessage(m) {\n    m = SHOW_MESSAGES &amp;&amp; typeof m === &quot;string&quot; ? m.trim() : &quot;&quot;;\n    var el = document.getElementById(&quot;msg&quot;);\n    if (m === msgText) return;\n    msgText = m;\n    if (m) {\n      el.style.fontSize = Math.max(14, Math.min(window.innerHeight * MSG_SIZE, window.innerWidth * 0.028)) + &quot;px&quot;;\n      el.innerText = m;\n      el.classList.add(&quot;show&quot;);\n    } else el.classList.remove(&quot;show&quot;);   // fades out, keeping the last text until it&apos;s gone\n  }\n\n  function onData(d) {\n    showMessage(d[&quot;notification_text&quot;]);\n    lastKeys = d;\n    if (debugOn) showDebug();\n    var t = workoutPos(d);\n    if (t === null) return;\n    if (t === lastTime) return;\n    if (t &lt; lastTime &amp;&amp; t &gt;= lastTime - 3000) return;   // a late update that&apos;s slightly older than the last one: ignore it\n\n    if (t &lt; lastTime - 3000) {\n      // Moved backwards: a new workout, or rewound. Drop power drawn past this point.\n      if (t &lt; 3000) { samples = []; resetWbal(); }\n      else { while (samples.length &amp;&amp; (!samples[samples.length - 1] || samples[samples.length - 1][0] &gt; t)) samples.pop(); }\n      smoothBuf = [];\n    } else if (lastTime &gt;= 0 &amp;&amp; t &gt; lastTime + 5000) {\n      // Skipped ahead: start a new piece of line so it doesn&apos;t stretch across the gap\n      samples.push(null);\n      smoothBuf = [];\n    }\n    running = lastTime &gt;= 0 &amp;&amp; t &gt; lastTime &amp;&amp; t - lastTime &lt; 5000;\n    lastTime = t;\n    lastWall = performance.now();\n\n    var p = heldNum(d, [&quot;Power&quot;], &quot;p&quot;);\n    var hr = heldNum(d, [&quot;Heart Rate&quot;], &quot;hr&quot;);\n    // Rolling average over the last SMOOTH_SECS seconds of riding time\n    var now = Date.now();   // wall clock, so the short average keeps moving even if GoldenCheetah&apos;s elapsed time is stopped\n    smoothBuf.push([now, p, hr]);\n    while (smoothBuf.length &gt; 1 &amp;&amp; now - smoothBuf[0][0] &gt;= SMOOTH_SECS * 1000) smoothBuf.shift();\n    var avg = 0;\n    for (var q = 0; q &lt; smoothBuf.length; q++) avg += smoothBuf[q][1];\n    avg = avg / smoothBuf.length;\n    var wb = d[&quot;W&apos; bal&quot;];\n    if (wb === undefined) wb = d[&quot;wbal&quot;];\n    wb = (wb === undefined || isNaN(Number(wb))) ? -1 : Number(wb);\n    var wi = -1;\n    if (wbalCalc()) { recordPower(d, p); wi = rec.length - 1; }\n    else if (wb &gt; wprime) wprime = wb;\n    samples.push([t, avg, hr, wb, wi]);   // heart rate and W&apos; balance are drawn as-is, no smoothing\n\n    // No planned profile available: build one from the live target so the blue still appears\n    if (!rawProfile) {\n      var tgt = Number(d[&quot;Target Power&quot;]) || 0;\n      profile.push([t, tgt]);\n      if (t &gt; durationMs) durationMs = t;\n    }\n    dirty = true;\n  }\n\n  // Double-click the chart to show or hide the raw telemetry (helps if the line gets out of step)\n  var debugOn = false;\n  function showDebug() {\n    var el = document.getElementById(&quot;debug&quot;);\n    var lines = [];\n    for (var k in lastKeys) lines.push(k + &quot;: &quot; + lastKeys[k]);\n    el.innerText = lines.join(&quot;  |  &quot;);\n  }\n  document.addEventListener(&quot;dblclick&quot;, function () {\n    debugOn = !debugOn;\n    document.getElementById(&quot;debug&quot;).style.display = debugOn ? &quot;block&quot; : &quot;none&quot;;\n    if (debugOn) showDebug();\n  });\n\n\n  // ---------- Zone coloring ----------\n  function hexRgb(h) { return [parseInt(h.substr(1, 2), 16), parseInt(h.substr(3, 2), 16), parseInt(h.substr(5, 2), 16)]; }\n  var ZONE_RGB = ZONE_COLORS.map(hexRgb);\n  function zoneColor(pct) {\n    var half = FADE_PCT / 2;\n    for (var i = 0; i &lt; ZONE_TOPS.length; i++) {\n      var b = ZONE_TOPS[i];\n      if (pct &lt; b - half) return &quot;rgb(&quot; + ZONE_RGB[i].join(&quot;,&quot;) + &quot;)&quot;;\n      if (pct &lt;= b + half) {\n        var f = (pct - (b - half)) / FADE_PCT, a = ZONE_RGB[i], c = ZONE_RGB[i + 1];\n        return &quot;rgb(&quot; + Math.round(a[0] + (c[0] - a[0]) * f) + &quot;,&quot; + Math.round(a[1] + (c[1] - a[1]) * f) + &quot;,&quot; + Math.round(a[2] + (c[2] - a[2]) * f) + &quot;)&quot;;\n      }\n    }\n    return &quot;rgb(&quot; + ZONE_RGB[ZONE_RGB.length - 1].join(&quot;,&quot;) + &quot;)&quot;;\n  }\n  // Target watts at a point in the workout (follows ramps and steps)\n  var tgtIdx = 0;\n  function targetAt(ms) {\n    var n = profile.length;\n    if (!n) return 0;\n    if (tgtIdx &gt;= n || profile[tgtIdx][0] &gt; ms) tgtIdx = 0;\n    while (tgtIdx + 1 &lt; n &amp;&amp; profile[tgtIdx + 1][0] &lt;= ms) tgtIdx++;\n    var a = profile[tgtIdx], b = profile[tgtIdx + 1];\n    if (!b || b[0] &lt;= a[0]) return a[1];\n    return a[1] + (b[1] - a[1]) * (ms - a[0]) / (b[0] - a[0]);\n  }\n  // Outline of the workout with gently rounded corners (the workout file itself is unchanged)\n  function roundedProfilePath(X, Y, H) {\n    var pts = [[X(profile[0][0]), H]];\n    for (var a = 0; a &lt; profile.length; a++) {\n      var px = X(profile[a][0]), py = Y(profile[a][1]), lp = pts[pts.length - 1];\n      if (Math.abs(px - lp[0]) &lt; 0.01 &amp;&amp; Math.abs(py - lp[1]) &lt; 0.01) continue;\n      pts.push([px, py]);\n    }\n    pts.push([X(profile[profile.length - 1][0]), H]);\n    var r0 = CORNER_RADIUS * (window.devicePixelRatio || 1);\n    ctx.beginPath();\n    ctx.moveTo(pts[0][0], pts[0][1]);\n    for (var i = 1; i &lt; pts.length - 1; i++) {\n      var p0 = pts[i - 1], p1 = pts[i], p2 = pts[i + 1];\n      var d1 = Math.hypot(p1[0] - p0[0], p1[1] - p0[1]), d2 = Math.hypot(p2[0] - p1[0], p2[1] - p1[1]);\n      var r = Math.min(r0, d1 / 2, d2 / 2);\n      if (r &gt; 0.5) ctx.arcTo(p1[0], p1[1], p2[0], p2[1], r);\n      else ctx.lineTo(p1[0], p1[1]);\n    }\n    ctx.lineTo(pts[pts.length - 1][0], pts[pts.length - 1][1]);\n    ctx.closePath();\n  }\n\n  // Fill the workout shape, coloring each sliver by its target zone\n  function paintProfile(X, Y, msAtX, W, H) {\n    if (!profile.length) return;\n    ctx.save();\n    roundedProfilePath(X, Y, H);\n    ctx.clip();\n    var f = ftp || 200, step = Math.max(1, Math.round(window.devicePixelRatio || 1));\n    var x0 = Math.max(0, Math.floor(X(profile[0][0]))), x1 = Math.min(W, Math.ceil(X(profile[profile.length - 1][0])));\n    tgtIdx = 0;\n    for (var x = x0; x &lt; x1; x += step) {\n      ctx.fillStyle = zoneColor(targetAt(msAtX(x + step / 2)) / f * 100);\n      ctx.fillRect(x, 0, step, H);\n    }\n    ctx.restore();\n  }\n\n\n  // ---------- W&apos; balance line ----------\n  // Drawn on its own scale: bottom of the chart = empty, top = full W&apos; (from GoldenCheetah, or the highest value seen)\n  var wprime = 0;\n\n  // Calculated W&apos; balance (Skiba integral, as in GoldenCheetah&apos;s Activities W&apos; bal and the battery gauge):\n  // one power reading per second of the ride (paused time counts as 0 W). Tau = 546 x e^(-0.01 x (CP - average\n  // watts below CP)) + 316 s from the ride so far, and the whole line is recalculated with it on every update,\n  // so by the end it has the same shape as the Activities chart.\n  var cp = 0, rec = [], recAcc = 0, recNow = null, recPos = null, wbSeries = [];\n  function wbalCalc() { return WBAL_SOURCE === &quot;calculated&quot; &amp;&amp; cp &gt; 0 &amp;&amp; wprime &gt; 0; }\n  function resetWbal() { rec = []; recAcc = 0; recNow = null; recPos = null; wbSeries = []; }\n  function recordPower(d, P) {\n    var now = Date.now(), pos = Number(d[&quot;Current Position&quot;]);\n    var moving = !isNaN(pos) ? (recPos !== null &amp;&amp; pos &gt; recPos) : (P &gt; 0);\n    if (!isNaN(pos)) recPos = pos;\n    if (recNow === null) { if (moving) recNow = now; return; }\n    var dt = Math.max(0, (now - recNow) / 1000); recNow = now;\n    var w = moving &amp;&amp; P &gt; 0 ? Math.round(P) : 0;\n    if (dt &gt; 3) { for (var g = 1; g &lt; Math.round(dt); g++) rec.push(0); dt = 1; }\n    recAcc += dt;\n    while (recAcc &gt;= 0.5) { rec.push(w); recAcc -= 1; }\n    var below = 0, nb = 0, i;\n    for (i = 0; i &lt; rec.length; i++) if (rec[i] &lt; cp) { below += rec[i]; nb++; }\n    var tau = Math.floor(546 * Math.exp(-0.01 * (cp - (nb &gt; 0 ? below / nb : 0))) + 316);\n    var k = Math.exp(-1 / tau), used = 0;\n    wbSeries = new Array(rec.length);\n    for (i = 0; i &lt; rec.length; i++) { used = used * k + (rec[i] &gt; cp ? rec[i] - cp : 0); wbSeries[i] = wprime - used; }\n  }\n  function wbAt(sp) {\n    if (wbalCalc() &amp;&amp; sp[4] !== undefined) return sp[4] &gt;= 0 &amp;&amp; wbSeries[sp[4]] !== undefined ? Math.max(0, wbSeries[sp[4]]) : (sp[4] &lt; 0 ? -1 : wprime);\n    return sp[3];\n  }\n  function wbalColor(pct) {\n    for (var i = 1; i &lt; WBAL_LEVELS.length; i++) {\n      if (pct &lt;= WBAL_LEVELS[i][0]) {\n        var a = WBAL_LEVELS[i - 1], b = WBAL_LEVELS[i], f = (pct - a[0]) / Math.max(1, b[0] - a[0]);\n        var ca = hexRgb(a[1]), cb = hexRgb(b[1]);\n        return &quot;rgb(&quot; + Math.round(ca[0] + (cb[0] - ca[0]) * f) + &quot;,&quot; + Math.round(ca[1] + (cb[1] - ca[1]) * f) + &quot;,&quot; + Math.round(ca[2] + (cb[2] - ca[2]) * f) + &quot;)&quot;;\n      }\n    }\n    return WBAL_LEVELS[WBAL_LEVELS.length - 1][1];\n  }\n  function wbalLine(X, H, pad, fromMs, toMs, endMs) {\n    var full = wprime;\n    if (!(full &gt; 0)) return;\n    var dpr = window.devicePixelRatio || 1;\n    function Yw(j) { return H - pad - Math.max(0, Math.min(1, j / full)) * (H - 2 * pad); }\n    // collect visible points (breaks where data is missing or the workout jumped)\n    var runs = [], cur = [];\n    for (var b = 0; b &lt; samples.length; b++) {\n      var sp = samples[b];\n      if (!sp || !(wbAt(sp) &gt;= 0)) { if (cur.length) runs.push(cur); cur = []; continue; }\n      if (sp[0] &lt; fromMs || sp[0] &gt; toMs) continue;\n      cur.push([sp[0], wbAt(sp)]);\n    }\n    if (cur.length) {\n      if (endMs !== null &amp;&amp; endMs &gt; cur[cur.length - 1][0]) cur.push([endMs, cur[cur.length - 1][1]]);\n      runs.push(cur);\n    }\n    ctx.lineJoin = &quot;round&quot;; ctx.lineCap = &quot;round&quot;;\n    // dark edge first, then the colored line piece by piece\n    if (LINE_OUTLINE) {\n      ctx.beginPath();\n      for (var r = 0; r &lt; runs.length; r++) {\n        var pts = runs[r];\n        ctx.moveTo(X(pts[0][0]), Yw(pts[0][1]));\n        for (var k = 1; k &lt; pts.length; k++) ctx.lineTo(X(pts[k][0]), Yw(pts[k][1]));\n      }\n      ctx.strokeStyle = LINE_OUTLINE; ctx.lineWidth = (WBAL_WIDTH + 2) * dpr; ctx.stroke();\n    }\n    ctx.lineWidth = WBAL_WIDTH * dpr;\n    for (var r2 = 0; r2 &lt; runs.length; r2++) {\n      var q = runs[r2], col = null;\n      for (var m = 1; m &lt; q.length; m++) {\n        var c = wbalColor(Math.round((q[m - 1][1] + q[m][1]) / 2 / full * 100));\n        if (c !== col) {\n          if (col !== null) ctx.stroke();\n          ctx.beginPath(); ctx.moveTo(X(q[m - 1][0]), Yw(q[m - 1][1])); ctx.strokeStyle = c; col = c;\n        }\n        ctx.lineTo(X(q[m][0]), Yw(q[m][1]));\n      }\n      if (col !== null) ctx.stroke();\n    }\n  }\n\n  function draw() {\n    if (!dirty &amp;&amp; !running) return;\n    dirty = false;\n    var W = canvas.width, H = canvas.height;\n    ctx.fillStyle = &quot;#000&quot;;\n    ctx.fillRect(0, 0, W, H);\n    if (lastTime &lt; 0 &amp;&amp; !profile.length) return;\n\n    // Current point in the workout, moved on smoothly between updates while riding\n    var target = Math.max(0, lastTime);\n    if (running) {\n      var ahead = performance.now() - lastWall;\n      if (ahead &gt; 2000) running = false; else target += ahead;\n    }\n    // Glide toward that position: a little faster when behind, a little slower when ahead, so small\n    // differences between GoldenCheetah&apos;s updates and the clock are smoothed out instead of jumping back\n    var tnow = performance.now(), dt = lastFrame ? Math.min(100, tnow - lastFrame) : 0;\n    lastFrame = tnow;\n    if (disp === null || Math.abs(target - disp) &gt; 3000) disp = target;                 // skips, rewinds, new workout: go straight there\n    else if (running) disp += dt * Math.max(0.2, Math.min(2, 1 + (target - disp) / 1000));\n    else if (target &gt; disp) disp += (target - disp) * 0.2;                              // paused: settle forward only\n    if (running || Math.abs(target - disp) &gt; 5) dirty = true;                          // keep drawing until it settles\n    var now = disp;\n    if (durationMs) now = Math.min(now, durationMs);\n\n    // Same vertical scale as the full workout chart\n    var maxW = 0;\n    for (var i = 0; i &lt; profile.length; i++) maxW = Math.max(maxW, profile[i][1]);\n    for (var j = 0; j &lt; samples.length; j++) if (samples[j]) maxW = Math.max(maxW, samples[j][1], samples[j][2]);\n    maxW = Math.max(100, maxW * 1.12);\n    var pad = Math.round(H * 0.03);\n    var left = now - HALF_MS;\n    function X(ms) { return (ms - left) / (2 * HALF_MS) * W; }\n    function Y(w) { return H - pad - (w / maxW) * (H - 2 * pad); }\n\n    // Workout profile, colored by zone (anything before the start or after the end stays black)\n    paintProfile(X, Y, function (px) { return left + px / W * (2 * HALF_MS); }, W, H);\n\n    // Heart rate (red) and power (yellow) inside the window, extended to &quot;now&quot; so they meet the middle\n    function line(idx, color, width) {\n      ctx.beginPath();\n      var pen = false, last = null;\n      for (var b = 0; b &lt; samples.length; b++) {\n        var sp = samples[b];\n        if (!sp || !(sp[idx] &gt; 0 || idx === 1)) { pen = false; last = null; continue; }\n        if (sp[0] &lt; left - 6000) continue;\n        if (!pen) { ctx.moveTo(X(sp[0]), Y(sp[idx])); pen = true; }\n        else ctx.lineTo(X(sp[0]), Y(sp[idx]));\n        last = sp;\n      }\n      if (pen &amp;&amp; last &amp;&amp; running) ctx.lineTo(X(now), Y(last[idx]));\n      var dpr = window.devicePixelRatio || 1;\n      ctx.lineJoin = &quot;round&quot;;\n      if (LINE_OUTLINE) {\n        ctx.strokeStyle = LINE_OUTLINE;\n        ctx.lineWidth = (width + 2) * dpr;\n        ctx.stroke();\n      }\n      ctx.strokeStyle = color;\n      ctx.lineWidth = width * dpr;\n      ctx.stroke();\n    }\n    line(2, HR_COLOR, HR_WIDTH);\n    wbalLine(X, H, pad, left - 6000, Infinity, running ? now : null);\n    line(1, POWER_COLOR, POWER_WIDTH);\n\n    // &quot;Now&quot; marker in the middle\n    if (CENTER_COLOR) {\n      ctx.fillStyle = CENTER_COLOR;\n      ctx.fillRect(Math.round(W / 2), 0, Math.max(1, Math.round(window.devicePixelRatio || 1)), H);\n    }\n    timeMarks(X, W, H, left, left + 2 * HALF_MS, markStepMs(), durationMs || 0);\n  }\n\n\n  // ---------- Time markers along the bottom ----------\n  function fmtClock(ms) {\n    var t = Math.round(ms / 1000), h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;\n    return (h &gt; 0 ? h + &quot;:&quot; + String(m).padStart(2, &quot;0&quot;) : m) + &quot;:&quot; + String(s).padStart(2, &quot;0&quot;);\n  }\n  function timeMarks(X, W, H, fromMs, toMs, stepMs, endMs) {\n    if (!SHOW_TIME_MARKS || !(stepMs &gt; 0)) return;\n    var dpr = window.devicePixelRatio || 1, size = Math.round(TIME_MARK_SIZE * dpr), tick = Math.round(5 * dpr);\n    ctx.font = &quot;600 &quot; + size + &quot;px -apple-system, &apos;Segoe UI&apos;, Roboto, Helvetica, Arial, sans-serif&quot;;\n    ctx.textBaseline = &quot;bottom&quot;;\n    var marks = [];\n    for (var t = Math.max(0, Math.ceil(fromMs / stepMs) * stepMs); t &lt;= toMs; t += stepMs) if (!endMs || t &lt; endMs) marks.push(t);\n    if (endMs &amp;&amp; endMs &gt;= fromMs &amp;&amp; endMs &lt;= toMs) {\n      // keep the end label clear of the last regular one\n      while (marks.length &amp;&amp; X(endMs) - X(marks[marks.length - 1]) &lt; ctx.measureText(&quot;00:00&quot;).width * 1.6) marks.pop();\n      marks.push(endMs);\n    }\n    for (var i = 0; i &lt; marks.length; i++) {\n      var x = X(marks[i]), label = fmtClock(marks[i]);\n      if (x &lt; -1 || x &gt; W + 1) continue;\n      var w = ctx.measureText(label).width, gap = Math.round(3 * dpr);\n      var tx = Math.min(W - w - gap, Math.max(gap, x - w / 2));   // first and last labels stay inside the chart\n      ctx.fillStyle = TIME_MARK_COLOR;\n      ctx.fillRect(Math.round(Math.min(W - dpr, Math.max(0, x))), H - tick, Math.max(1, Math.round(dpr)), tick);\n      ctx.lineJoin = &quot;round&quot;; ctx.lineWidth = Math.round(3 * dpr); ctx.strokeStyle = &quot;rgba(0,0,0,0.75)&quot;;\n      ctx.strokeText(label, tx, H - tick - Math.round(1 * dpr));\n      ctx.fillText(label, tx, H - tick - Math.round(1 * dpr));\n    }\n  }\n\n\n  // ---------- Paused message ----------\n  function onState(st) {\n    st = String(st || &quot;&quot;).toLowerCase();\n    var paused = st.indexOf(&quot;pause&quot;) &gt;= 0;\n    document.getElementById(&quot;paused&quot;).classList.toggle(&quot;show&quot;, SHOW_PAUSED &amp;&amp; paused);\n    document.body.classList.toggle(&quot;paused&quot;, SHOW_PAUSED &amp;&amp; paused);\n  }\n\n  function loop() { draw(); requestAnimationFrame(loop); }\n\n  window.addEventListener(&quot;resize&quot;, resize);\n  window.onload = function () {\n    resize();\n    loop();\n    if (typeof QWebChannel !== &quot;undefined&quot; &amp;&amp; window.qt &amp;&amp; qt.webChannelTransport) {\n      new QWebChannel(qt.webChannelTransport, function (channel) {\n        var gc = channel.objects.gc;\n        if (gc &amp;&amp; gc.getConfig) { var r = gc.getConfig(applyConfig); if (r &amp;&amp; r.then) r.then(applyConfig); }\n        if (gc &amp;&amp; gc.getPlannedRoute) { var q = gc.getPlannedRoute(applyRoute); if (q &amp;&amp; q.then) q.then(applyRoute); }\n        if (gc &amp;&amp; gc.plannedRouteChanged) gc.plannedRouteChanged.connect(applyRoute);\n        if (gc &amp;&amp; gc.stateChanged) gc.stateChanged.connect(onState);\n        if (gc &amp;&amp; gc.telemetry) gc.telemetry.connect(function (p) { onData(typeof p === &quot;string&quot; ? JSON.parse(p) : (p || {})); });\n      });\n    } else {\n      // Browser preview: an 8 x 2 min interval workout played in real time.\n      // Add ?start=SECONDS to the address to start part way through.\n      document.getElementById(&quot;status&quot;).innerText = &quot;Preview (simulated data)&quot;;\n      // simple simulated W&apos; balance (CP 220 W, W&apos; 20 kJ)\n      var simBal = 20000, simLast = null;\n      function simW(p) {\n        var tt = window.simT !== undefined ? window.simT : simT;\n        var dt = simLast === null ? 1 : Math.max(0, (tt - simLast) / 1000); simLast = tt;\n        if (p &gt; 220) simBal -= (p - 220) * dt; else simBal += (20000 - simBal) * (1 - Math.exp(-dt / 300));\n        simBal = Math.max(0, simBal);\n        return simBal;\n      }\n\n      ftp = 220;\n      var prof = [[0, 100], [300000, 160]];\n      var t = 300000;\n      for (var k = 0; k &lt; 8; k++) { prof.push([t, 280], [t + 120000, 280], [t + 120000, 110], [t + 240000, 110]); t += 240000; }\n      prof.push([t, 180], [t + 300000, 150], [t + 300000, 100], [t + 480000, 100]);\n      applyRoute({ workout: { duration_msecs: t + 480000, profile: prof } });\n      var st = Number(new URLSearchParams(location.search).get(&quot;start&quot;)) || 0;\n      window.simT = st * 1000; window.el = 0;\n      setInterval(function () {\n        window.simT += 500; window.el += 500;\n        var tgt = 0;\n        for (var i = 1; i &lt; prof.length; i++) if (window.simT &lt;= prof[i][0]) {\n          var p0 = prof[i - 1], p1 = prof[i], f = p1[0] &gt; p0[0] ? (window.simT - p0[0]) / (p1[0] - p0[0]) : 1;\n          tgt = p0[1] + (p1[1] - p0[1]) * f; break;\n        }\n        var cue = (window.simT % 60000) &lt; 6000 ? &quot;Interval &quot; + (Math.floor(window.simT / 60000) % 5 + 1) + &quot; of 5 starts in 5 seconds: 111% FTP&quot; : &quot;&quot;;\n        if (window.simT &lt;= durationMs) onData({ &quot;notification_text&quot;: cue,  &quot;Time&quot;: window.el, &quot;Current Position&quot;: window.simT, &quot;Power&quot;: tgt + (Math.random() * 50 - 25), &quot;Heart Rate&quot;: 110 + tgt * 0.15 + Math.random() * 4, &quot;W&apos; bal&quot;: simW(tgt), &quot;Target Power&quot;: tgt });\n      }, 500);\n    }\n  };\n\n  // ---------- Legend (colors come from the line settings above, so it always matches the chart) ----------\n  function buildLegend() {\n    var el = document.getElementById(&quot;legend&quot;);\n    if (!SHOW_LEGEND || !el) return;\n    var stops = WBAL_LEVELS.slice().reverse().map(function (l) { return l[1] + &quot; &quot; + (100 - l[0]) + &quot;%&quot;; }).join(&quot;, &quot;);\n    var grad = WBAL_LEVELS.slice().reverse().map(function (l) { return &apos;&lt;stop offset=&quot;&apos; + (100 - l[0]) + &apos;%&quot; stop-color=&quot;&apos; + l[1] + &apos;&quot;/&gt;&apos;; }).join(&quot;&quot;);\n    var edge = &apos;stroke=&quot;&apos; + LINE_OUTLINE + &apos;&quot; stroke-width=&quot;3.6&quot; fill=&quot;none&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;&apos;;\n    function line(d, color, poly) {\n      var tag = poly ? &apos;&lt;polyline points=&quot;&apos; + d + &apos;&quot; &apos; : &apos;&lt;path d=&quot;&apos; + d + &apos;&quot; &apos;;\n      return &apos;&lt;svg viewBox=&quot;0 0 40 12&quot;&gt;&apos; + (color.indexOf(&quot;url&quot;) === 0 ? &apos;&lt;defs&gt;&lt;linearGradient id=&quot;wbg&quot; x1=&quot;0&quot; x2=&quot;1&quot; y1=&quot;0&quot; y2=&quot;0&quot;&gt;&apos; + grad + &apos;&lt;/linearGradient&gt;&lt;/defs&gt;&apos; : &quot;&quot;) +\n        tag + edge + &apos;/&gt;&apos; + tag + &apos;stroke=&quot;&apos; + color + &apos;&quot; stroke-width=&quot;1.8&quot; fill=&quot;none&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;/&gt;&lt;/svg&gt;&apos;;\n    }\n    var sep = &apos;&lt;span class=&quot;sep&quot;&gt;&lt;/span&gt;&apos;;\n    el.innerHTML =\n      &apos;&lt;span class=&quot;it&quot; style=&quot;color:&apos; + POWER_COLOR + &apos;&quot;&gt;PWR&apos; + line(&quot;0,8 4,4 7,9 11,3 14,7 18,2 21,8 25,5 28,9 32,3 36,7 40,4&quot;, POWER_COLOR, true) + &apos;&lt;/span&gt;&apos; + sep +\n      &apos;&lt;span class=&quot;it&quot; style=&quot;color:&apos; + HR_COLOR + &apos;&quot;&gt;HR&apos; + line(&quot;M0,8 C3,8 4,4 7,4 S11,9 15,8 S19,3 23,4 S27,9 31,8 S36,4 40,5&quot;, HR_COLOR, false) + &apos;&lt;/span&gt;&apos; + sep +\n      &apos;&lt;span class=&quot;it&quot;&gt;&lt;span class=&quot;wb&quot; style=&quot;background-image: linear-gradient(90deg, &apos; + stops + &apos;)&quot;&gt;W’&lt;/span&gt;&apos; + line(&quot;M0,4 C10,0 24,1 40,10&quot;, &quot;url(#wbg)&quot;, false) + &apos;&lt;/span&gt;&apos;;\n    el.style.display = &quot;flex&quot;;\n  }\n  window.addEventListener(&quot;load&quot;, buildLegend);\n\n  // ---------- Zoom slider (spaced so each step is the same amount of zoom; 3:00 sits a little under halfway) ----------\n  function markStepMs() {\n    if (TIME_MARK_SECS &gt; 0) return TIME_MARK_SECS * 1000;\n    var steps = [10, 15, 30, 60, 120, 180, 300, 600];\n    for (var i = 0; i &lt; steps.length; i++) if (2 * HALF_MS / (steps[i] * 1000) &lt;= TIME_MARK_MAX) return steps[i] * 1000;\n    return 600000;\n  }\n  function buildZoom() {\n    var el = document.getElementById(&quot;zoom&quot;);\n    if (!SHOW_ZOOM || !el) return;\n    var lo = Math.log(ZOOM_MIN_MINS * 60), hi = Math.log(ZOOM_MAX_MINS * 60);\n    function mag(plus) {\n      return &apos;&lt;svg class=&quot;ic&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;circle cx=&quot;10&quot; cy=&quot;10&quot; r=&quot;6.5&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2.2&quot;/&gt;&apos; +\n        &apos;&lt;path d=&quot;M15 15l5.5 5.5&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2.6&quot; stroke-linecap=&quot;round&quot;/&gt;&apos; +\n        &apos;&lt;path d=&quot;M7 10h6&apos; + (plus ? &apos;M10 7v6&apos; : &apos;&apos;) + &apos;&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;/&gt;&lt;/svg&gt;&apos;;\n    }\n    el.innerHTML = &apos;&lt;span id=&quot;zout&quot; title=&quot;Zoom out&quot;&gt;&apos; + mag(false) + &apos;&lt;/span&gt;&lt;input id=&quot;zr&quot; type=&quot;range&quot; min=&quot;0&quot; max=&quot;1000&quot; step=&quot;1&quot; title=&quot;Zoom&quot;&gt;&apos; +\n      &apos;&lt;span id=&quot;zin&quot; title=&quot;Zoom in&quot;&gt;&apos; + mag(true) + &apos;&lt;/span&gt;&lt;span class=&quot;val&quot; id=&quot;zv&quot;&gt;&lt;/span&gt;&apos;;\n    var r = document.getElementById(&quot;zr&quot;), v = document.getElementById(&quot;zv&quot;);\n    function posOf(secs) { return Math.round((Math.log(secs) - lo) / (hi - lo) * 1000); }\n    function setSecs(secs, moveThumb) {\n      secs = Math.max(ZOOM_MIN_MINS * 60, Math.min(ZOOM_MAX_MINS * 60, Math.round(secs / ZOOM_STEP_SECS) * ZOOM_STEP_SECS));\n      HALF_MS = secs * 500;\n      if (moveThumb) r.value = posOf(secs);\n      r.style.setProperty(&quot;--p&quot;, (r.value / 10) + &quot;%&quot;);\n      v.textContent = Math.floor(secs / 60) + &quot;:&quot; + (&quot;0&quot; + (secs % 60)).slice(-2);\n      dirty = true;\n    }\n    function current() { return HALF_MS / 500; }\n    r.addEventListener(&quot;input&quot;, function () { setSecs(Math.exp(lo + (hi - lo) * r.value / 1000), false); });\n    r.addEventListener(&quot;change&quot;, function () { setSecs(current(), true); r.blur(); });   // snap the thumb, give the keyboard back to GoldenCheetah\n    // The magnifiers jump to the next of these window lengths (in minutes)\n    var NOTCHES = [1, 1.5, 2, 3, 4, 5, 6, 8, 10, 12, 15];\n    function nudge(dir) {\n      var m = current() / 60, list = NOTCHES.filter(function (x) { return x &gt;= ZOOM_MIN_MINS &amp;&amp; x &lt;= ZOOM_MAX_MINS; });\n      var n = dir &gt; 0 ? list.filter(function (x) { return x &gt; m + 0.01; })[0] : list.filter(function (x) { return x &lt; m - 0.01; }).pop();\n      setSecs((n === undefined ? (dir &gt; 0 ? ZOOM_MAX_MINS : ZOOM_MIN_MINS) : n) * 60, true);\n    }\n    document.getElementById(&quot;zout&quot;).addEventListener(&quot;click&quot;, function () { nudge(1); });\n    document.getElementById(&quot;zin&quot;).addEventListener(&quot;click&quot;, function () { nudge(-1); });\n    setSecs(ZOOM_DEFAULT_MINS * 60, true);\n    el.style.display = &quot;flex&quot;;\n  }\n  window.addEventListener(&quot;load&quot;, buildZoom);\n&lt;/script&gt;\n&lt;/body&gt;\n&lt;/html&gt;" />
		<property name="splitterState" type="QByteArray" value="" />
		<property name="showEditor" type="bool" value="0" />
		<property name="chartConfig" type="QString" value="" />
		<property name="showTitleBar" type="bool" value="0" />
	</chart>
	<chart id="58" name="" title="Gauges" >
		<property name="title" type="QString" value="Gauges" />
		<property name="subtitle" type="QString" value="" />
		<property name="widthFactor" type="double" value="1" />
		<property name="heightFactor" type="double" value="3" />
		<property name="style" type="int" value="2" />
		<property name="resizable" type="bool" value="1" />
		<property name="html" type="QString" value="&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n&lt;meta charset=&quot;utf-8&quot;&gt;\n&lt;title&gt;Gauges Row&lt;/title&gt;\n&lt;script src=&quot;qrc:///qtwebchannel/qwebchannel.js&quot;&gt;&lt;/script&gt;\n&lt;style&gt;\n  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #000; }\n  /* One row, left to right: heart rate, power, W&apos; battery, on target, cadence */\n  #row { position: absolute; inset: 0; display: flex; justify-content: center; align-items: center; gap: var(--gap); }\n  .sq { height: var(--u); width: var(--u); flex: none; }\n  .bat { height: var(--u); width: calc(var(--u) * var(--bw)); flex: none; }\n  iframe { border: 0; width: 100%; height: 100%; display: block; background: #000; }\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n&lt;div id=&quot;row&quot;&gt;\n  &lt;div class=&quot;sq&quot;&gt;&lt;iframe data-k=&quot;hr&quot;&gt;&lt;/iframe&gt;&lt;/div&gt;\n  &lt;div class=&quot;sq&quot;&gt;&lt;iframe data-k=&quot;pw&quot;&gt;&lt;/iframe&gt;&lt;/div&gt;\n  &lt;div class=&quot;bat&quot;&gt;&lt;iframe data-k=&quot;wb&quot;&gt;&lt;/iframe&gt;&lt;/div&gt;\n  &lt;div class=&quot;sq&quot;&gt;&lt;iframe data-k=&quot;cp&quot;&gt;&lt;/iframe&gt;&lt;/div&gt;\n  &lt;div class=&quot;sq&quot;&gt;&lt;iframe data-k=&quot;cd&quot;&gt;&lt;/iframe&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;script&gt;\n  // ---------- Settings ----------\n  var GAP = 14;            // space between gauges, in pixels\n  var PAD = 4;             // space above and below the row, in pixels\n  var BATTERY_WIDTH = 1.5; // battery card width compared to one gauge\n  var BATTERY_SIZE = 0.62; // battery size inside its card in this row (overrides the gauge&apos;s own BATTERY_SCALE)\n  var BATTERY_TEXT = 0.85; // percent and kJ text size in this row (1 = the gauge&apos;s own size)\n\n  // Size every gauge the same: as tall as the row allows, but narrow enough that all five fit across\n  function size() {\n    var byH = window.innerHeight - PAD * 2;\n    var byW = (window.innerWidth - GAP * 6) / (4 + BATTERY_WIDTH);\n    var u = Math.max(60, Math.floor(Math.min(byH, byW)));\n    var st = document.documentElement.style;\n    st.setProperty(&quot;--u&quot;, u + &quot;px&quot;); st.setProperty(&quot;--gap&quot;, GAP + &quot;px&quot;); st.setProperty(&quot;--bw&quot;, BATTERY_WIDTH);\n  }\n  size();\n  window.addEventListener(&quot;resize&quot;, size);\n\n  // The five gauges, each stored as base64 so nothing in them needs escaping\n  var PARTS = {\n    hr: &quot;&quot;,\n    pw: &quot;&quot;,\n    wb: &quot;&quot;,\n    cd: &quot;&quot;,\n    cp: &quot;&quot;\n  };\n  function decode(b64) {\n    var bin = atob(b64), bytes = new Uint8Array(bin.length);\n    for (var i = 0; i &lt; bin.length; i++) bytes[i] = bin.charCodeAt(i);\n    return new TextDecoder(&quot;utf-8&quot;).decode(bytes);\n  }\n  // Connect to GoldenCheetah once; the gauges share this connection\n  if (typeof QWebChannel !== &quot;undefined&quot; &amp;&amp; window.qt &amp;&amp; qt.webChannelTransport) {\n    new QWebChannel(qt.webChannelTransport, function (channel) { window.__gcChannel = channel; });\n  }\n  document.querySelectorAll(&quot;iframe[data-k]&quot;).forEach(function (f) {\n    var k = f.getAttribute(&quot;data-k&quot;), html = decode(PARTS[k]);\n    if (k === &quot;wb&quot;) html = html.replace(/var BATTERY_SCALE = [0-9.]+;/, &quot;var BATTERY_SCALE = &quot; + BATTERY_SIZE + &quot;;&quot;)\n                               .replace(/var TEXT_SCALE = [0-9.]+;/, &quot;var TEXT_SCALE = &quot; + BATTERY_TEXT + &quot;;&quot;);\n    f.srcdoc = html;\n  });\n&lt;/script&gt;\n&lt;/body&gt;\n&lt;/html&gt;" />
		<property name="splitterState" type="QByteArray" value="" />
		<property name="showEditor" type="bool" value="0" />
		<property name="chartConfig" type="QString" value="" />
		<property name="showTitleBar" type="bool" value="0" />
	</chart>
	<chart id="58" name="" title="Full Workout" >
		<property name="title" type="QString" value="Full Workout" />
		<property name="subtitle" type="QString" value="" />
		<property name="widthFactor" type="double" value="1" />
		<property name="heightFactor" type="double" value="3.57143" />
		<property name="style" type="int" value="2" />
		<property name="resizable" type="bool" value="1" />
		<property name="html" type="QString" value="&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n&lt;meta charset=&quot;utf-8&quot;&gt;\n&lt;title&gt;Full Workout&lt;/title&gt;\n&lt;script src=&quot;qrc:///qtwebchannel/qwebchannel.js&quot;&gt;&lt;/script&gt;\n&lt;style&gt;\n  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #000; }\n  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n  #debug { position: fixed; left: 0; right: 0; bottom: 0; display: none; padding: 4px 8px; background: rgba(0,0,0,0.8);\n    font: 11px Consolas, monospace; color: #9ef; white-space: normal; max-height: 60%; overflow: auto; }\n  /* Message center: coaching messages from the workout file, centered over the chart */\n  #msgwrap { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }\n  #msg { max-width: 72%; box-sizing: border-box; padding: 0.45em 1.1em; border-radius: 0.7em; text-align: center;\n    font: 700 22px -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; letter-spacing: 0.02em; line-height: 1.25; color: #fff;\n    background: rgba(0,0,0,0.12); border: 1px solid rgba(255,255,255,0.18);\n    box-shadow: none;\n    text-shadow: 0 0 2px #000, 0 0 3px #000, 0 1px 6px rgba(0,0,0,0.9), 0 0 14px rgba(0,0,0,0.6);   /* dark edge keeps the text readable on any color */\n    opacity: 0; transform: translateY(6px) scale(0.98); transition: opacity 0.6s ease, transform 0.6s ease; }\n  #msg.show { opacity: 1; transform: none; transition: opacity 0.35s ease, transform 0.35s ease; }\n  /* Paused message */\n  #pausewrap { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 6; }\n  #paused { font: 800 calc(var(--wh) * 0.2) -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; letter-spacing: 0.25em; color: #fff;\n    padding: 0.12em 0.45em 0.12em 0.7em; border-radius: 0.22em; background: rgba(0,0,0,0.12); border: 1px solid rgba(255,255,255,0.2);\n    text-shadow: 0 0 2px #000, 0 0 4px #000, 0 2px 10px rgba(0,0,0,0.9); opacity: 0; transition: opacity 0.4s ease; }\n  #paused.show { opacity: 1; animation: breathe 2.4s ease-in-out infinite; }\n  @keyframes breathe { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }\n  body.paused #msgwrap { opacity: 0; }\n  /* Legend: one compact line in the upper left (PWR | HR | W&apos;), nearly solid black so it stays readable over the chart */\n  #legend { position: absolute; left: 6px; top: 6px; z-index: 5; pointer-events: none; box-sizing: border-box;\n    padding: 0.2em 0.6em; border-radius: 0.5em; background: rgba(0,0,0,0.85); border: 1px solid rgba(255,255,255,0.18);\n    font: 700 clamp(10px, 0.6vw, 14px) -apple-system, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif; letter-spacing: 0.06em; line-height: 1.3;\n    display: none; align-items: center; white-space: nowrap; }\n  #legend .it { display: inline-flex; align-items: center; gap: 0.35em; }\n  #legend .sep { width: 1px; height: 0.95em; background: rgba(255,255,255,0.55); margin: 0 0.6em; flex: none; }\n  #legend svg { width: 2.2em; height: 0.85em; overflow: visible; flex: none; }\n  #legend .wb { display: inline-block; -webkit-background-clip: text; background-clip: text; color: transparent; }\n  #status { position: fixed; top: 2px; right: 6px; font: 10px -apple-system, &quot;Segoe UI&quot;, Arial, sans-serif; color: rgba(255,255,255,0.4); }\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n&lt;canvas id=&quot;c&quot;&gt;&lt;/canvas&gt;\n&lt;div id=&quot;legend&quot;&gt;&lt;/div&gt;\n&lt;div id=&quot;msgwrap&quot;&gt;&lt;div id=&quot;msg&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;div id=&quot;pausewrap&quot;&gt;&lt;div id=&quot;paused&quot;&gt;PAUSED&lt;/div&gt;&lt;/div&gt;\n&lt;div id=&quot;status&quot;&gt;&lt;/div&gt;\n&lt;div id=&quot;debug&quot;&gt;&lt;/div&gt;\n&lt;script&gt;\n  // ---------- Dropout guard ----------\n  var HOLD_SECS = 2;   // a reading that briefly drops out (missing, or a sudden 0) keeps its last value this long\n  var _held = {};\n  function heldNum(d, keys, name) {\n    var v, i, now = Date.now();\n    for (i = 0; i &lt; keys.length; i++) if (d[keys[i]] !== undefined &amp;&amp; d[keys[i]] !== null &amp;&amp; d[keys[i]] !== &quot;&quot;) { v = Number(d[keys[i]]); break; }\n    var h = _held[name] || (_held[name] = { v: 0, at: 0 });\n    if (v === undefined || isNaN(v)) return h.v;                       // not in this update: keep the last value\n    if (v &gt; 0) { h.v = v; h.at = now; return v; }\n    if (h.v &gt; 0 &amp;&amp; now - h.at &lt; HOLD_SECS * 1000 + 500) return h.v;    // a short dropout: keep showing the last value\n    h.v = v; return v;\n  }\n  // ---------- Settings ----------\n  // Workout is colored by the target&apos;s power zone (% of FTP), fading over 3 percentage points at each boundary\n  var ZONE_COLORS = [&quot;#29c5ff&quot;, &quot;#0066ff&quot;, &quot;#00d64f&quot;, &quot;#ffd400&quot;, &quot;#ff6a00&quot;, &quot;#ff1f3d&quot;]; // Z1 recovery .. Z6/7 anaerobic and sprint\n  var CORNER_RADIUS = 6;          // rounding on the workout&apos;s corners, in pixels (0 = square)\n  var ZONE_TOPS = [55.5, 75.5, 90.5, 105.5, 120.5];  // zone boundaries in % FTP (Z1 &lt;=55, Z2 56-75, Z3 76-90, Z4 91-105, Z5 106-120, Z6+ &gt;120)\n  var FADE_PCT = 3;                // width of each color fade, in % FTP\n  var LINE_OUTLINE = &quot;rgba(0,0,0,0.65)&quot;;  // thin dark edge so the lines stay visible on yellow and red blocks\n  var POWER_COLOR = &quot;#ffe94d&quot;;     // power line\n  var POWER_WIDTH = 1.5;           // power line thickness (px)\n  var HR_COLOR = &quot;#ff2a2a&quot;;        // heart rate line\n  var HR_WIDTH = 1.5;              // heart rate line thickness (px)\n  var WBAL_SOURCE = &quot;calculated&quot;;  // W&apos; balance line: &quot;calculated&quot; = same formula as GoldenCheetah&apos;s Activities W&apos; bal (and the battery gauge)\n                                   //    &quot;goldencheetah&quot; = GoldenCheetah&apos;s own live number (recovers faster)\n  var WBAL_WIDTH = 2;               // W&apos; balance line thickness (px); colored by how full it is, like the battery\n  var WBAL_LEVELS = [[0, &quot;#ff1f3d&quot;], [15, &quot;#ff1f3d&quot;], [30, &quot;#ff6a00&quot;], [50, &quot;#ffd400&quot;], [70, &quot;#00d64f&quot;], [100, &quot;#00d64f&quot;]];\n  var SHOW_MESSAGES = false;       // message center over this chart (the Video player turns this on; the ERG player shows messages on the magnified chart)\n  var MSG_SIZE = 0.11;             // message text size, as a share of the chart height\n  var SHOW_PAUSED = false;         // big &quot;PAUSED&quot; over this chart while paused (on in the Video player)\n  var SHOW_POSITION = true;        // thin &quot;you are here&quot; line at your current spot, as tall as the current part of the workout\n  var POSITION_COLOR = &quot;#ffffff&quot;;  // color of that line\n  var PAST_DIM = 0.5;              // how much to darken the part of the workout you&apos;ve already ridden (0 = none, 1 = black)\n  var SHOW_TIME_MARKS = true;      // small time labels along the bottom\n  var TIME_MARK_MIN = 0;           // minutes between labels (0 = automatic: 5, 10, 15 or 30 depending on workout length)\n  var TIME_MARK_SIZE = 11;         // label text size, in pixels\n  var TIME_MARK_COLOR = &quot;rgba(255,255,255,0.85)&quot;;\n  var SHOW_LEGEND = true;          // one-line legend in the upper left (PWR, HR, W&apos;)\n  var SMOOTH_SECS = 3;             // power smoothing: average of the last 3 seconds (0 = raw); heart rate is not smoothed\n\n  var profile = [];      // [[msecs, watts], ...]\n  var durationMs = 0;\n  var ftp = 0;\n  var samples = [];      // [[msecs, watts, bpm], ...]\n  var smoothBuf = [];\n  var lastTime = -1;\n  var dirty = true;\n\n  var canvas = document.getElementById(&quot;c&quot;);\n  var ctx = canvas.getContext(&quot;2d&quot;);\n\n  function resize() {\n    document.documentElement.style.setProperty(&quot;--wh&quot;, window.innerHeight + &quot;px&quot;);\n    var r = window.devicePixelRatio || 1;\n    canvas.width = Math.max(1, Math.round(window.innerWidth * r));\n    canvas.height = Math.max(1, Math.round(window.innerHeight * r));\n    dirty = true;\n  }\n\n  function applyConfig(c) {\n    try {\n      if (typeof c === &quot;string&quot;) c = JSON.parse(c);\n      if (c &amp;&amp; c.power &amp;&amp; (c.power.ftp || c.power.cp)) ftp = Number(c.power.ftp || c.power.cp) || 0;\n      if (c &amp;&amp; c.power &amp;&amp; c.power.wprime) wprime = Math.max(wprime, Number(c.power.wprime) || 0);\n      if (c &amp;&amp; c.power &amp;&amp; (c.power.cp || c.power.ftp)) cp = Number(c.power.cp || c.power.ftp) || cp;\n    } catch (e) { }\n    normaliseProfile();\n    dirty = true;\n  }\n\n  var rawProfile = null;\n  function applyRoute(r) {\n    try {\n      if (typeof r === &quot;string&quot;) r = JSON.parse(r);\n      if (!r || !r.workout) return;\n      rawProfile = r.workout.profile || null;\n      durationMs = Number(r.workout.duration_msecs) || 0;\n      normaliseProfile();\n      samples = []; lastTime = -1;\n      dirty = true;\n    } catch (e) { }\n  }\n\n  // Accept watts, or fractions of FTP if every value is small\n  function normaliseProfile() {\n    if (!rawProfile || !rawProfile.length) return;\n    var maxV = 0;\n    for (var i = 0; i &lt; rawProfile.length; i++) maxV = Math.max(maxV, Number(rawProfile[i][1]) || 0);\n    var k = (maxV &gt; 0 &amp;&amp; maxV &lt;= 5) ? (ftp || 200) : 1;\n    profile = rawProfile.map(function (p) { return [Number(p[0]) || 0, (Number(p[1]) || 0) * k]; });\n    if (!durationMs) durationMs = profile[profile.length - 1][0];\n  }\n\n  // Where we are in the workout. Elapsed &quot;Time&quot; keeps counting normally when you skip ahead,\n  // so use the workout position instead.\n  var REMAIN_KEYS = [&quot;Ergo Time Remaining&quot;, &quot;Workout Time Remaining&quot;, &quot;Erg Time Remaining&quot;, &quot;Total Time Remaining&quot;];\n  // GoldenCheetah sends the workout position in milliseconds as &quot;Current Position&quot;;\n  // it jumps when you fast forward or rewind, unlike &quot;Time&quot;.\n  var POS_KEYS = [&quot;Current Position&quot;, &quot;Workout Time&quot;, &quot;Ergo Time&quot;];\n  var lastKeys = {};\n\n  function workoutPos(d) {\n    var i, v;\n    for (i = 0; i &lt; POS_KEYS.length; i++) {\n      v = d[POS_KEYS[i]];\n      if (v !== undefined &amp;&amp; !isNaN(Number(v))) return Number(v);\n    }\n    if (durationMs &gt; 0) {\n      for (i = 0; i &lt; REMAIN_KEYS.length; i++) {\n        v = d[REMAIN_KEYS[i]];\n        if (v !== undefined &amp;&amp; !isNaN(Number(v))) return Math.max(0, durationMs - Number(v));\n      }\n    }\n    v = Number(d[&quot;Time&quot;]);\n    return isNaN(v) ? null : v;\n  }\n\n  // GoldenCheetah sends the current message as &quot;notification_text&quot; for as long as it should show\n  var msgText = &quot;&quot;;\n  function showMessage(m) {\n    m = SHOW_MESSAGES &amp;&amp; typeof m === &quot;string&quot; ? m.trim() : &quot;&quot;;\n    var el = document.getElementById(&quot;msg&quot;);\n    if (m === msgText) return;\n    msgText = m;\n    if (m) {\n      el.style.fontSize = Math.max(14, Math.min(window.innerHeight * MSG_SIZE, window.innerWidth * 0.028)) + &quot;px&quot;;\n      el.innerText = m;\n      el.classList.add(&quot;show&quot;);\n    } else el.classList.remove(&quot;show&quot;);   // fades out, keeping the last text until it&apos;s gone\n  }\n\n  function onData(d) {\n    showMessage(d[&quot;notification_text&quot;]);\n    lastKeys = d;\n    if (debugOn) showDebug();\n    var t = workoutPos(d);\n    if (t === null) return;\n    if (t === lastTime) return;\n\n    if (t &lt; lastTime - 3000) {\n      // Moved backwards: a new workout, or rewound. Drop power drawn past this point.\n      if (t &lt; 3000) { samples = []; resetWbal(); }\n      else { while (samples.length &amp;&amp; (!samples[samples.length - 1] || samples[samples.length - 1][0] &gt; t)) samples.pop(); }\n      smoothBuf = [];\n    } else if (lastTime &gt;= 0 &amp;&amp; t &gt; lastTime + 5000) {\n      // Skipped ahead: start a new piece of line so it doesn&apos;t stretch across the gap\n      samples.push(null);\n      smoothBuf = [];\n    }\n    lastTime = t;\n\n    var p = heldNum(d, [&quot;Power&quot;], &quot;p&quot;);\n    var hr = heldNum(d, [&quot;Heart Rate&quot;], &quot;hr&quot;);\n    // Rolling average over the last SMOOTH_SECS seconds of riding time\n    var now = Date.now();   // wall clock, so the short average keeps moving even if GoldenCheetah&apos;s elapsed time is stopped\n    smoothBuf.push([now, p, hr]);\n    while (smoothBuf.length &gt; 1 &amp;&amp; now - smoothBuf[0][0] &gt;= SMOOTH_SECS * 1000) smoothBuf.shift();\n    var avg = 0;\n    for (var q = 0; q &lt; smoothBuf.length; q++) avg += smoothBuf[q][1];\n    avg = avg / smoothBuf.length;\n    var wb = d[&quot;W&apos; bal&quot;];\n    if (wb === undefined) wb = d[&quot;wbal&quot;];\n    wb = (wb === undefined || isNaN(Number(wb))) ? -1 : Number(wb);\n    var wi = -1;\n    if (wbalCalc()) { recordPower(d, p); wi = rec.length - 1; }\n    else if (wb &gt; wprime) wprime = wb;\n    samples.push([t, avg, hr, wb, wi]);   // heart rate and W&apos; balance are drawn as-is, no smoothing\n\n    // No planned profile available: build one from the live target so the blue still appears\n    if (!rawProfile) {\n      var tgt = Number(d[&quot;Target Power&quot;]) || 0;\n      profile.push([t, tgt]);\n      if (t &gt; durationMs) durationMs = t;\n    }\n    dirty = true;\n  }\n\n  // Double-click the chart to show or hide the raw telemetry (helps if the line gets out of step)\n  var debugOn = false;\n  function showDebug() {\n    var el = document.getElementById(&quot;debug&quot;);\n    var lines = [];\n    for (var k in lastKeys) lines.push(k + &quot;: &quot; + lastKeys[k]);\n    el.innerText = lines.join(&quot;  |  &quot;);\n  }\n  document.addEventListener(&quot;dblclick&quot;, function () {\n    debugOn = !debugOn;\n    document.getElementById(&quot;debug&quot;).style.display = debugOn ? &quot;block&quot; : &quot;none&quot;;\n    if (debugOn) showDebug();\n  });\n\n\n  // ---------- Zone coloring ----------\n  function hexRgb(h) { return [parseInt(h.substr(1, 2), 16), parseInt(h.substr(3, 2), 16), parseInt(h.substr(5, 2), 16)]; }\n  var ZONE_RGB = ZONE_COLORS.map(hexRgb);\n  function zoneColor(pct) {\n    var half = FADE_PCT / 2;\n    for (var i = 0; i &lt; ZONE_TOPS.length; i++) {\n      var b = ZONE_TOPS[i];\n      if (pct &lt; b - half) return &quot;rgb(&quot; + ZONE_RGB[i].join(&quot;,&quot;) + &quot;)&quot;;\n      if (pct &lt;= b + half) {\n        var f = (pct - (b - half)) / FADE_PCT, a = ZONE_RGB[i], c = ZONE_RGB[i + 1];\n        return &quot;rgb(&quot; + Math.round(a[0] + (c[0] - a[0]) * f) + &quot;,&quot; + Math.round(a[1] + (c[1] - a[1]) * f) + &quot;,&quot; + Math.round(a[2] + (c[2] - a[2]) * f) + &quot;)&quot;;\n      }\n    }\n    return &quot;rgb(&quot; + ZONE_RGB[ZONE_RGB.length - 1].join(&quot;,&quot;) + &quot;)&quot;;\n  }\n  // Target watts at a point in the workout (follows ramps and steps)\n  var tgtIdx = 0;\n  function targetAt(ms) {\n    var n = profile.length;\n    if (!n) return 0;\n    if (tgtIdx &gt;= n || profile[tgtIdx][0] &gt; ms) tgtIdx = 0;\n    while (tgtIdx + 1 &lt; n &amp;&amp; profile[tgtIdx + 1][0] &lt;= ms) tgtIdx++;\n    var a = profile[tgtIdx], b = profile[tgtIdx + 1];\n    if (!b || b[0] &lt;= a[0]) return a[1];\n    return a[1] + (b[1] - a[1]) * (ms - a[0]) / (b[0] - a[0]);\n  }\n  // Outline of the workout with gently rounded corners (the workout file itself is unchanged)\n  function roundedProfilePath(X, Y, H) {\n    var pts = [[X(profile[0][0]), H]];\n    for (var a = 0; a &lt; profile.length; a++) {\n      var px = X(profile[a][0]), py = Y(profile[a][1]), lp = pts[pts.length - 1];\n      if (Math.abs(px - lp[0]) &lt; 0.01 &amp;&amp; Math.abs(py - lp[1]) &lt; 0.01) continue;\n      pts.push([px, py]);\n    }\n    pts.push([X(profile[profile.length - 1][0]), H]);\n    var r0 = CORNER_RADIUS * (window.devicePixelRatio || 1);\n    ctx.beginPath();\n    ctx.moveTo(pts[0][0], pts[0][1]);\n    for (var i = 1; i &lt; pts.length - 1; i++) {\n      var p0 = pts[i - 1], p1 = pts[i], p2 = pts[i + 1];\n      var d1 = Math.hypot(p1[0] - p0[0], p1[1] - p0[1]), d2 = Math.hypot(p2[0] - p1[0], p2[1] - p1[1]);\n      var r = Math.min(r0, d1 / 2, d2 / 2);\n      if (r &gt; 0.5) ctx.arcTo(p1[0], p1[1], p2[0], p2[1], r);\n      else ctx.lineTo(p1[0], p1[1]);\n    }\n    ctx.lineTo(pts[pts.length - 1][0], pts[pts.length - 1][1]);\n    ctx.closePath();\n  }\n\n  // Fill the workout shape, coloring each sliver by its target zone\n  function paintProfile(X, Y, msAtX, W, H) {\n    if (!profile.length) return;\n    ctx.save();\n    roundedProfilePath(X, Y, H);\n    ctx.clip();\n    var f = ftp || 200, step = Math.max(1, Math.round(window.devicePixelRatio || 1));\n    var x0 = Math.max(0, Math.floor(X(profile[0][0]))), x1 = Math.min(W, Math.ceil(X(profile[profile.length - 1][0])));\n    tgtIdx = 0;\n    for (var x = x0; x &lt; x1; x += step) {\n      ctx.fillStyle = zoneColor(targetAt(msAtX(x + step / 2)) / f * 100);\n      ctx.fillRect(x, 0, step, H);\n    }\n    ctx.restore();\n  }\n\n\n  // ---------- W&apos; balance line ----------\n  // Drawn on its own scale: bottom of the chart = empty, top = full W&apos; (from GoldenCheetah, or the highest value seen)\n  var wprime = 0;\n\n  // Calculated W&apos; balance (Skiba integral, as in GoldenCheetah&apos;s Activities W&apos; bal and the battery gauge):\n  // one power reading per second of the ride (paused time counts as 0 W). Tau = 546 x e^(-0.01 x (CP - average\n  // watts below CP)) + 316 s from the ride so far, and the whole line is recalculated with it on every update,\n  // so by the end it has the same shape as the Activities chart.\n  var cp = 0, rec = [], recAcc = 0, recNow = null, recPos = null, wbSeries = [];\n  function wbalCalc() { return WBAL_SOURCE === &quot;calculated&quot; &amp;&amp; cp &gt; 0 &amp;&amp; wprime &gt; 0; }\n  function resetWbal() { rec = []; recAcc = 0; recNow = null; recPos = null; wbSeries = []; }\n  function recordPower(d, P) {\n    var now = Date.now(), pos = Number(d[&quot;Current Position&quot;]);\n    var moving = !isNaN(pos) ? (recPos !== null &amp;&amp; pos &gt; recPos) : (P &gt; 0);\n    if (!isNaN(pos)) recPos = pos;\n    if (recNow === null) { if (moving) recNow = now; return; }\n    var dt = Math.max(0, (now - recNow) / 1000); recNow = now;\n    var w = moving &amp;&amp; P &gt; 0 ? Math.round(P) : 0;\n    if (dt &gt; 3) { for (var g = 1; g &lt; Math.round(dt); g++) rec.push(0); dt = 1; }\n    recAcc += dt;\n    while (recAcc &gt;= 0.5) { rec.push(w); recAcc -= 1; }\n    var below = 0, nb = 0, i;\n    for (i = 0; i &lt; rec.length; i++) if (rec[i] &lt; cp) { below += rec[i]; nb++; }\n    var tau = Math.floor(546 * Math.exp(-0.01 * (cp - (nb &gt; 0 ? below / nb : 0))) + 316);\n    var k = Math.exp(-1 / tau), used = 0;\n    wbSeries = new Array(rec.length);\n    for (i = 0; i &lt; rec.length; i++) { used = used * k + (rec[i] &gt; cp ? rec[i] - cp : 0); wbSeries[i] = wprime - used; }\n  }\n  function wbAt(sp) {\n    if (wbalCalc() &amp;&amp; sp[4] !== undefined) return sp[4] &gt;= 0 &amp;&amp; wbSeries[sp[4]] !== undefined ? Math.max(0, wbSeries[sp[4]]) : (sp[4] &lt; 0 ? -1 : wprime);\n    return sp[3];\n  }\n  function wbalColor(pct) {\n    for (var i = 1; i &lt; WBAL_LEVELS.length; i++) {\n      if (pct &lt;= WBAL_LEVELS[i][0]) {\n        var a = WBAL_LEVELS[i - 1], b = WBAL_LEVELS[i], f = (pct - a[0]) / Math.max(1, b[0] - a[0]);\n        var ca = hexRgb(a[1]), cb = hexRgb(b[1]);\n        return &quot;rgb(&quot; + Math.round(ca[0] + (cb[0] - ca[0]) * f) + &quot;,&quot; + Math.round(ca[1] + (cb[1] - ca[1]) * f) + &quot;,&quot; + Math.round(ca[2] + (cb[2] - ca[2]) * f) + &quot;)&quot;;\n      }\n    }\n    return WBAL_LEVELS[WBAL_LEVELS.length - 1][1];\n  }\n  function wbalLine(X, H, pad, fromMs, toMs, endMs) {\n    var full = wprime;\n    if (!(full &gt; 0)) return;\n    var dpr = window.devicePixelRatio || 1;\n    function Yw(j) { return H - pad - Math.max(0, Math.min(1, j / full)) * (H - 2 * pad); }\n    // collect visible points (breaks where data is missing or the workout jumped)\n    var runs = [], cur = [];\n    for (var b = 0; b &lt; samples.length; b++) {\n      var sp = samples[b];\n      if (!sp || !(wbAt(sp) &gt;= 0)) { if (cur.length) runs.push(cur); cur = []; continue; }\n      if (sp[0] &lt; fromMs || sp[0] &gt; toMs) continue;\n      cur.push([sp[0], wbAt(sp)]);\n    }\n    if (cur.length) {\n      if (endMs !== null &amp;&amp; endMs &gt; cur[cur.length - 1][0]) cur.push([endMs, cur[cur.length - 1][1]]);\n      runs.push(cur);\n    }\n    ctx.lineJoin = &quot;round&quot;; ctx.lineCap = &quot;round&quot;;\n    // dark edge first, then the colored line piece by piece\n    if (LINE_OUTLINE) {\n      ctx.beginPath();\n      for (var r = 0; r &lt; runs.length; r++) {\n        var pts = runs[r];\n        ctx.moveTo(X(pts[0][0]), Yw(pts[0][1]));\n        for (var k = 1; k &lt; pts.length; k++) ctx.lineTo(X(pts[k][0]), Yw(pts[k][1]));\n      }\n      ctx.strokeStyle = LINE_OUTLINE; ctx.lineWidth = (WBAL_WIDTH + 2) * dpr; ctx.stroke();\n    }\n    ctx.lineWidth = WBAL_WIDTH * dpr;\n    for (var r2 = 0; r2 &lt; runs.length; r2++) {\n      var q = runs[r2], col = null;\n      for (var m = 1; m &lt; q.length; m++) {\n        var c = wbalColor(Math.round((q[m - 1][1] + q[m][1]) / 2 / full * 100));\n        if (c !== col) {\n          if (col !== null) ctx.stroke();\n          ctx.beginPath(); ctx.moveTo(X(q[m - 1][0]), Yw(q[m - 1][1])); ctx.strokeStyle = c; col = c;\n        }\n        ctx.lineTo(X(q[m][0]), Yw(q[m][1]));\n      }\n      if (col !== null) ctx.stroke();\n    }\n  }\n\n  function draw() {\n    if (!dirty) return;\n    dirty = false;\n    var W = canvas.width, H = canvas.height;\n    ctx.fillStyle = &quot;#000&quot;;\n    ctx.fillRect(0, 0, W, H);\n    var lastS = samples.length ? samples[samples.length - 1] : null;\n    var total = durationMs || (lastS ? lastS[0] : 0);\n    if (!total) return;\n\n    var maxW = 0;\n    for (var i = 0; i &lt; profile.length; i++) maxW = Math.max(maxW, profile[i][1]);\n    for (var j = 0; j &lt; samples.length; j++) if (samples[j]) maxW = Math.max(maxW, samples[j][1], samples[j][2]);\n    maxW = Math.max(100, maxW * 1.12);\n    var pad = Math.round(H * 0.03);\n    function X(ms) { return ms / total * W; }\n    function Y(w) { return H - pad - (w / maxW) * (H - 2 * pad); }\n\n    // Workout profile, colored by zone\n    paintProfile(X, Y, function (px) { return px / W * total; }, W, H);\n\n    // Darken the part of the workout that&apos;s already done (your power and heart rate lines stay bright)\n    var here = lastTime &gt; 0 ? Math.min(lastTime, total) : 0;\n    if (SHOW_POSITION &amp;&amp; here &gt; 0 &amp;&amp; PAST_DIM &gt; 0) {\n      ctx.fillStyle = &quot;rgba(0,0,0,&quot; + PAST_DIM + &quot;)&quot;;\n      ctx.fillRect(0, 0, Math.round(X(here)), H);\n    }\n\n    // Heart rate (red) and power (yellow) drawn so far, on the same scale as the workout\n    function line(idx, color, width) {\n      ctx.beginPath();\n      var pen = false;\n      for (var b = 0; b &lt; samples.length; b++) {\n        var sp = samples[b];\n        if (!sp || !(sp[idx] &gt; 0 || idx === 1)) { pen = false; continue; }\n        if (!pen) { ctx.moveTo(X(sp[0]), Y(sp[idx])); pen = true; }\n        else ctx.lineTo(X(sp[0]), Y(sp[idx]));\n      }\n      var dpr = window.devicePixelRatio || 1;\n      ctx.lineJoin = &quot;round&quot;;\n      if (LINE_OUTLINE) {\n        ctx.strokeStyle = LINE_OUTLINE;\n        ctx.lineWidth = (width + 2) * dpr;\n        ctx.stroke();\n      }\n      ctx.strokeStyle = color;\n      ctx.lineWidth = width * dpr;\n      ctx.stroke();\n    }\n    if (samples.length &gt; 1) {\n      line(2, HR_COLOR, HR_WIDTH);\n      wbalLine(X, H, pad, -Infinity, Infinity, null);\n      line(1, POWER_COLOR, POWER_WIDTH);\n    }\n    // You are here\n    if (SHOW_POSITION &amp;&amp; here &gt; 0) {\n      var dpr2 = window.devicePixelRatio || 1, hx = Math.round(X(here));\n      ctx.save();\n      ctx.shadowColor = POSITION_COLOR; ctx.shadowBlur = 6 * dpr2;\n      ctx.fillStyle = POSITION_COLOR;\n      var top = Math.round(Y(targetAt(here)));   // only as tall as the current part of the workout\n      if (!(top &lt; H)) top = H - Math.round(6 * dpr2);\n      ctx.fillRect(hx - Math.round(dpr2), top, Math.max(2, Math.round(2 * dpr2)), H - top);\n      ctx.restore();\n    }\n    var mins = total / 60000, step = TIME_MARK_MIN || (mins &lt;= 25 ? 5 : mins &lt;= 70 ? 10 : mins &lt;= 130 ? 15 : 30);\n    timeMarks(X, W, H, 0, total, step * 60000, total);\n  }\n\n\n  // ---------- Time markers along the bottom ----------\n  function fmtClock(ms) {\n    var t = Math.round(ms / 1000), h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;\n    return (h &gt; 0 ? h + &quot;:&quot; + String(m).padStart(2, &quot;0&quot;) : m) + &quot;:&quot; + String(s).padStart(2, &quot;0&quot;);\n  }\n  function timeMarks(X, W, H, fromMs, toMs, stepMs, endMs) {\n    if (!SHOW_TIME_MARKS || !(stepMs &gt; 0)) return;\n    var dpr = window.devicePixelRatio || 1, size = Math.round(TIME_MARK_SIZE * dpr), tick = Math.round(5 * dpr);\n    ctx.font = &quot;600 &quot; + size + &quot;px -apple-system, &apos;Segoe UI&apos;, Roboto, Helvetica, Arial, sans-serif&quot;;\n    ctx.textBaseline = &quot;bottom&quot;;\n    var marks = [];\n    for (var t = Math.max(0, Math.ceil(fromMs / stepMs) * stepMs); t &lt;= toMs; t += stepMs) if (!endMs || t &lt; endMs) marks.push(t);\n    if (endMs &amp;&amp; endMs &gt;= fromMs &amp;&amp; endMs &lt;= toMs) {\n      // keep the end label clear of the last regular one\n      while (marks.length &amp;&amp; X(endMs) - X(marks[marks.length - 1]) &lt; ctx.measureText(&quot;00:00&quot;).width * 1.6) marks.pop();\n      marks.push(endMs);\n    }\n    for (var i = 0; i &lt; marks.length; i++) {\n      var x = X(marks[i]), label = fmtClock(marks[i]);\n      if (x &lt; -1 || x &gt; W + 1) continue;\n      var w = ctx.measureText(label).width, gap = Math.round(3 * dpr);\n      var tx = Math.min(W - w - gap, Math.max(gap, x - w / 2));   // first and last labels stay inside the chart\n      ctx.fillStyle = TIME_MARK_COLOR;\n      ctx.fillRect(Math.round(Math.min(W - dpr, Math.max(0, x))), H - tick, Math.max(1, Math.round(dpr)), tick);\n      ctx.lineJoin = &quot;round&quot;; ctx.lineWidth = Math.round(3 * dpr); ctx.strokeStyle = &quot;rgba(0,0,0,0.75)&quot;;\n      ctx.strokeText(label, tx, H - tick - Math.round(1 * dpr));\n      ctx.fillText(label, tx, H - tick - Math.round(1 * dpr));\n    }\n  }\n\n  // ---------- Paused message ----------\n  function onState(st) {\n    st = String(st || &quot;&quot;).toLowerCase();\n    var paused = st.indexOf(&quot;pause&quot;) &gt;= 0;\n    document.getElementById(&quot;paused&quot;).classList.toggle(&quot;show&quot;, SHOW_PAUSED &amp;&amp; paused);\n    document.body.classList.toggle(&quot;paused&quot;, SHOW_PAUSED &amp;&amp; paused);\n  }\n\n  function loop() { draw(); requestAnimationFrame(loop); }\n\n  window.addEventListener(&quot;resize&quot;, resize);\n  window.onload = function () {\n    resize();\n    loop();\n    if (typeof QWebChannel !== &quot;undefined&quot; &amp;&amp; window.qt &amp;&amp; qt.webChannelTransport) {\n      new QWebChannel(qt.webChannelTransport, function (channel) {\n        var gc = channel.objects.gc;\n        if (gc &amp;&amp; gc.getConfig) { var r = gc.getConfig(applyConfig); if (r &amp;&amp; r.then) r.then(applyConfig); }\n        if (gc &amp;&amp; gc.getPlannedRoute) { var q = gc.getPlannedRoute(applyRoute); if (q &amp;&amp; q.then) q.then(applyRoute); }\n        if (gc &amp;&amp; gc.plannedRouteChanged) gc.plannedRouteChanged.connect(applyRoute);\n        if (gc &amp;&amp; gc.stateChanged) gc.stateChanged.connect(onState);\n        if (gc &amp;&amp; gc.telemetry) gc.telemetry.connect(function (p) { onData(typeof p === &quot;string&quot; ? JSON.parse(p) : (p || {})); });\n      });\n    } else {\n      // Browser preview: an 8 x 2 min interval workout, played back 60x faster\n      document.getElementById(&quot;status&quot;).innerText = &quot;Preview (simulated data)&quot;;\n      // simple simulated W&apos; balance (CP 220 W, W&apos; 20 kJ)\n      var simBal = 20000, simLast = null;\n      function simW(p) {\n        var tt = window.simT !== undefined ? window.simT : simT;\n        var dt = simLast === null ? 1 : Math.max(0, (tt - simLast) / 1000); simLast = tt;\n        if (p &gt; 220) simBal -= (p - 220) * dt; else simBal += (20000 - simBal) * (1 - Math.exp(-dt / 300));\n        simBal = Math.max(0, simBal);\n        return simBal;\n      }\n\n      ftp = 220;\n      var prof = [[0, 100], [300000, 160]];\n      var t = 300000;\n      for (var k = 0; k &lt; 8; k++) { prof.push([t, 280], [t + 120000, 280], [t + 120000, 110], [t + 240000, 110]); t += 240000; }\n      prof.push([t, 180], [t + 300000, 150], [t + 300000, 100], [t + 480000, 100]);\n      applyRoute({ workout: { duration_msecs: t + 480000, profile: prof } });\n      var simT = 0;\n      setInterval(function () {\n        simT += 60000 / 20;\n        if (simT &gt; 900000 &amp;&amp; !window.skipped) { window.skipped = true; simT += 480000; }\n        var tgt = 0;\n        for (var i = 1; i &lt; prof.length; i++) if (simT &lt;= prof[i][0]) {\n          var p0 = prof[i - 1], p1 = prof[i], f = p1[0] &gt; p0[0] ? (simT - p0[0]) / (p1[0] - p0[0]) : 1;\n          tgt = p0[1] + (p1[1] - p0[1]) * f; break;\n        }\n        window.el = (window.el || 0) + 3000;\n        if (simT &lt;= durationMs) onData({ &quot;Time&quot;: window.el, &quot;Current Position&quot;: simT, &quot;Power&quot;: tgt + (Math.random() * 50 - 25), &quot;Heart Rate&quot;: 110 + tgt * 0.15 + Math.random() * 4, &quot;W&apos; bal&quot;: simW(tgt), &quot;Target Power&quot;: tgt });\n      }, 50);\n    }\n  };\n\n  // ---------- Legend (colors come from the line settings above, so it always matches the chart) ----------\n  function buildLegend() {\n    var el = document.getElementById(&quot;legend&quot;);\n    if (!SHOW_LEGEND || !el) return;\n    var stops = WBAL_LEVELS.slice().reverse().map(function (l) { return l[1] + &quot; &quot; + (100 - l[0]) + &quot;%&quot;; }).join(&quot;, &quot;);\n    var grad = WBAL_LEVELS.slice().reverse().map(function (l) { return &apos;&lt;stop offset=&quot;&apos; + (100 - l[0]) + &apos;%&quot; stop-color=&quot;&apos; + l[1] + &apos;&quot;/&gt;&apos;; }).join(&quot;&quot;);\n    var edge = &apos;stroke=&quot;&apos; + LINE_OUTLINE + &apos;&quot; stroke-width=&quot;3.6&quot; fill=&quot;none&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;&apos;;\n    function line(d, color, poly) {\n      var tag = poly ? &apos;&lt;polyline points=&quot;&apos; + d + &apos;&quot; &apos; : &apos;&lt;path d=&quot;&apos; + d + &apos;&quot; &apos;;\n      return &apos;&lt;svg viewBox=&quot;0 0 40 12&quot;&gt;&apos; + (color.indexOf(&quot;url&quot;) === 0 ? &apos;&lt;defs&gt;&lt;linearGradient id=&quot;wbg&quot; x1=&quot;0&quot; x2=&quot;1&quot; y1=&quot;0&quot; y2=&quot;0&quot;&gt;&apos; + grad + &apos;&lt;/linearGradient&gt;&lt;/defs&gt;&apos; : &quot;&quot;) +\n        tag + edge + &apos;/&gt;&apos; + tag + &apos;stroke=&quot;&apos; + color + &apos;&quot; stroke-width=&quot;1.8&quot; fill=&quot;none&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;/&gt;&lt;/svg&gt;&apos;;\n    }\n    var sep = &apos;&lt;span class=&quot;sep&quot;&gt;&lt;/span&gt;&apos;;\n    el.innerHTML =\n      &apos;&lt;span class=&quot;it&quot; style=&quot;color:&apos; + POWER_COLOR + &apos;&quot;&gt;PWR&apos; + line(&quot;0,8 4,4 7,9 11,3 14,7 18,2 21,8 25,5 28,9 32,3 36,7 40,4&quot;, POWER_COLOR, true) + &apos;&lt;/span&gt;&apos; + sep +\n      &apos;&lt;span class=&quot;it&quot; style=&quot;color:&apos; + HR_COLOR + &apos;&quot;&gt;HR&apos; + line(&quot;M0,8 C3,8 4,4 7,4 S11,9 15,8 S19,3 23,4 S27,9 31,8 S36,4 40,5&quot;, HR_COLOR, false) + &apos;&lt;/span&gt;&apos; + sep +\n      &apos;&lt;span class=&quot;it&quot;&gt;&lt;span class=&quot;wb&quot; style=&quot;background-image: linear-gradient(90deg, &apos; + stops + &apos;)&quot;&gt;W’&lt;/span&gt;&apos; + line(&quot;M0,4 C10,0 24,1 40,10&quot;, &quot;url(#wbg)&quot;, false) + &apos;&lt;/span&gt;&apos;;\n    el.style.display = &quot;flex&quot;;\n  }\n  window.addEventListener(&quot;load&quot;, buildLegend);\n&lt;/script&gt;\n&lt;/body&gt;\n&lt;/html&gt;" />
		<property name="splitterState" type="QByteArray" value="" />
		<property name="showEditor" type="bool" value="0" />
		<property name="chartConfig" type="QString" value="" />
		<property name="showTitleBar" type="bool" value="0" />
	</chart>
</layout>
